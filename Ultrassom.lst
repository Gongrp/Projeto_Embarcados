    24: .def    TEMP1   = R16
    25: .def    TEMP2   = R17
    26: .def    TEMP3   = R18
    27: .def    DIST_CM = R20       ; resultado final da medição
    28: 
    29: .equ    PORTA_SENSOR = PORTD
    30: .equ    DDR_SENSOR   = DDRD
    31: .equ    PIN_SENSOR   = PIND
    32: 
    33: .equ    TRIG = 2             ; PD2
    34: .equ    ECHO = 3             ; PD3
    35: .equ    LED  = 4             ; PD4
    36: 
    37: .equ    LIMIAR_CM = 10        ; distância de detecção em cm
    38: 
    39: ; ============================================================
    40: ; TABELA DE VETORES
    41: ; ============================================================
    42: .cseg
    43: .org    0x0000
    44: 000000   C000  rjmp    INICIO
