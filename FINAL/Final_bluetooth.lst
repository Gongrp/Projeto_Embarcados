   238: ;////////////////////// SUB-ROTINAS //////////////////////////////////
   239: 
   240: DISPARA_TRIGGER:
   241: 00007A   9A2C  sbi     PORTB, TRIG
   242: ;10us a 16MHz = 160 ciclos de clock
   243: 00007B   E312  ldi     r17, 50
   244: 
   245: PULSO_TRIG: ;Aguarda 10 microsseg com TRIG em HIGH (delay implementado com decremento)
   246: 00007C   0000  nop
   247: 00007D   0000  nop
   248: 00007E   951A  dec     r17
   249: 00007F   F7E1  brne    PULSO_TRIG
   250: 000080   982C  cbi     PORTB, TRIG
   251: 000081   9508  ret
   252: 
   253: 
   254: ; Aguarda o pino ECHO ir para nível alto.
   255: ; Retorna: Carry = 1 se houve timeout (sem resposta do sensor)
   256: ;          Carry = 0 se ECHO subiu normalmente
   257: 
   258: ESPERA_ECHO_SUBIR:
   259: 000082   2722  clr r18           ; contador de timeout (256 voltas)
   260: 000083   9320  sts TCNT2,r18
        000084   00B2
   261: 000085   E021  ldi r18,(1<<TOV2)
   262: 000086   BB27  out TIFR2,r18      ; limpa flag pendente (escreve 1 para limpar)
   263: 000087   E026  ldi r18, (1<<CS22)|(1<<CS21)
   264: 000088   9320  sts TCCR2B,r18      ; inicia Timer2 com prescaler 256
        000089   00B1
   265: 
   266: LACO_ESPERA_SUBIDA:
   267: 00008A   991B  sbic    PINB, ECHO    ; se ECHO=0, pula a próxima linha
   268: 00008B   C009  rjmp    ECHO_OK_SUBIU
   269: 00008C   B327  in      r18,TIFR2
   270: 00008D   FD20  sbrc    R18,TOV2
   271: 00008E   C001  rjmp    TIMEOUT_SUBIDA
   272: 00008F   CFFA  rjmp    LACO_ESPERA_SUBIDA
   273: 
   274: TIMEOUT_SUBIDA:
   275: 000090   2722  clr     r18
   276: 000091   9320  sts     TCCR2B, r18       ; para o timer
        000092   00B1
   277: 000093   9408  sec                       ; timeout
   278: 000094   9508  ret
   279: 
   280: ECHO_OK_SUBIU:
   281: 000095   9488  clc                         ; limpa carry = sucesso
   282: 000096   9508  ret
   283: 
   284: 
   285: ;/////// CRONOMETRA_ECHO /////////////////////
   286: 
   287: ; Usa Timer2 com PS de 256 para contar quanto tempo o pino ECHO permanece em nível alto.
   288: 
   289: CRONOMETRA_ECHO:
   290: 000097   2700  clr     r16
   291: 000098   9300  sts     TCCR2B,r16 ;para o timer
        000099   00B1
   292: 00009A   9300  sts     TCNT2, r16 ;zera o contador
        00009B   00B2
   293: 00009C   E001  ldi     r16, (1<<TOV2)
   294: 00009D   BB07  out     TIFR2, r16         ; limpa flag pendente
   295: 
   296: ; Liga Timer2 com prescaler 256
   297: 00009E   E006  ldi     r16, (1<<CS22) | (1<<CS21)
   298: 00009F   9300  sts     TCCR2B, r16
        0000A0   00B1
   299: 
   300: 
   301: ESPERA_ECHO_DESCER:
   302: 0000A1   9B1B  sbis    PINB, ECHO
   303: 0000A2   C009  rjmp    ECHO_DESCEU_OK
   304: 0000A3   B307  in      r16, TIFR2
   305: 0000A4   FD00  sbrc    r16, TOV2  ;Pula para repetir o loop de espera enquanto não há overflow
   306: 0000A5   C001  rjmp    TIMEOUT_DESCIDA
   307: 0000A6   CFFA  rjmp    ESPERA_ECHO_DESCER
   308: 
   309: TIMEOUT_DESCIDA:
   310: ; TIMEOUT: para o timer e retorna distância máxima como indicador de timeout
   311: 0000A7   2700  clr     r16
   312: 0000A8   9300  sts     TCCR2B,r16
        0000A9   00B1
   313: 0000AA   EF4F  ldi     r20,0xFF
   314: 0000AB   9508  ret
   315: 
   316: 
   317: ECHO_DESCEU_OK:
   318: 0000AC   2700  clr     r16
   319: 0000AD   9300  sts     TCCR2B, r16 ;Para o timer2
        0000AE   00B1
   320: 
   321: 0000AF   9140  lds     r20, TCNT2    ;Lê valor de tempo de demora da detecção (será depois convertido em cm)
        0000B0   00B2
   322: 0000B1   9508  ret
   323: 
   324: ;//////////////////CONVERSÃO PARA CM ///////////////////////////////
   325: 
   326: ;OBS.: ADICIONAR FÓRMULA DE CONVERSÃO PARA CM
   327: 
   328: CONVERTE_PARA_CM:
   329: 0000B2   930F  push    R16
   330: 0000B3   931F  push    R17
   331: 0000B4   932F  push    R18
   332: 0000B5   920F  push    r0
   333: 0000B6   921F  push    r1
   334: 
   335: 0000B7   2F14  mov     r17, r20      ; Move o valor da distância para r17
   336: 0000B8   E00A  ldi     r16, 10
   337: 0000B9   9F10  mul     r17, r16        ; R1:R0 = ticks(tempo) * 10 (até 2550, 16 bits é suficiente)
   338: 0000BA   2D00  mov     r16, r0           ; r16 = byte baixo do produto
   339: 0000BB   2D21  mov     r18, r1           ; r18 = byte alto do produto
   340: 
   341: ; Divide o valor de 16 bits (r18:r16) por 36
   342: ; por subtração repetida, contando em r20
   343: 
   344: 0000BC   2744  clr     r20
   345: 
   346: DIV_LOOP:
   347: 0000BD   2322  tst     r18
   348: 0000BE   F411  brne    DIV_SUBTRAI         ; byte alto != 0 -> valor >= 256 >= 36
   349: 0000BF   3204  cpi     r16, 36
   350: 0000C0   F028  brlo    DIV_FIM             ; byte alto = 0 e baixo < 36 -> terminou
   351: 
   352: DIV_SUBTRAI:
   353: 0000C1   5204  subi    r16, 36
   354: 0000C2   F408  brcc    DIV_SEM_EMPRESTIMO
   355: 0000C3   952A  dec     r18               ; houve "borrow", ajusta byte alto
   356: 
   357: DIV_SEM_EMPRESTIMO:
   358: 0000C4   9543  inc     r20
   359: 0000C5   CFF7  rjmp    DIV_LOOP
   360: 
   361: DIV_FIM:
   362: ;Retorna os valores na pilha para seus registradores e encerra divisão
   363: 0000C6   901F  pop     r1
   364: 0000C7   900F  pop     r0
   365: 0000C8   912F  pop     r18
   366: 0000C9   911F  pop     r17
   367: 0000CA   910F  pop     r16
   368: 0000CB   9508  ret
   369: 
   370: ;/////////////////// TESTE DE DISTÂNCIA /////////////////////////////
   371: 
   372: ;Compara distância em cm medida com o limiar definido para determinar se o carrinho deve rotacionar, e em qual sentido (dependendo das rotações anteriores)
   373: ;Se estiver no meio de um processo de mudança de direção e não for detectado obstáculo, reinicia o movimento para frente
   374: 
   375: AVALIA_DISTANCIA:
   376: 0000CC   304A  cpi     r20, LIMIAR_CM
   377: 
   378: ;Se o valor em r20 for MENOR que o limiar -> obstáculo detectado
   379: 0000CD   F028  brlo    CHANGE_DIRECTION
   380: 
   381: 0000CE   1389  cpse CAR_STATE, R25
   382: 0000CF   9508  ret   ;Retorna sem reativar os motores quando o estado do carrinho for 0 (IDLE), se não só ignora
   383: 
   384: ;Se não, limpa o registrador de rotações, reativa motores e volta ao loop principal
   385: 0000D0   2766  clr ROT_COUNT
   386: 0000D1   D02A  rcall RUN_MOTORS
   387: 0000D2   9508  ret
   388: 
   389: CHANGE_DIRECTION:
   390: 0000D3   D02D  rcall STOP_MOTORS
   391: 
   392: ;Delay de segurança para esperar motores realmente pararem
   393: 0000D4   E906  ldi r16, STOP_DELAY_MS
   394: 0000D5   D017  rcall ESPERA_MS	    ;Reaproveita a mesma subrotina usada pro sensor ultrassônico
   395: 
   396: 0000D6   3060  cpi ROT_COUNT, 0x00
   397: 0000D7   F029  breq ROTATION_1
   398: 0000D8   3061  cpi ROT_COUNT, 0x01
   399: 0000D9   F039  breq ROTATION_2
   400: 0000DA   3062  cpi ROT_COUNT, 0x02
   401: 0000DB   F059  breq ROTATION_3
   402: 
   403: ;Se já estiver com o ROT_COUNT em 0x03 (encontrou obstáculo voltando a de onde veio, fica parado até detectar uma abertura)
   404: 0000DC   9508  ret	;Sem incrementar o contador de rotações
   405: 
   406: 
   407: ;Se ROT_COUNT for 0x00, segue no normal (ROTATION_1)
   408: ROTATION_1:
   409: ;Gira uma vez para a esquerda
   410: 0000DD   D02D  rcall TURN_LEFT
   411: 0000DE   D031  rcall WAIT_ROTATION
   412: 0000DF   D021  rcall STOP_MOTORS
   413: 0000E0   C00A  rjmp END_ROT
   414: 
   415: ROTATION_2:
   416: ;Gira duas vezes para a direita (sentido oposto da primeira rotação)
   417: 0000E1   D024  rcall TURN_RIGHT
   418: 0000E2   D02D  rcall WAIT_ROTATION
   419: 0000E3   D022  rcall TURN_RIGHT
   420: 0000E4   D02B  rcall WAIT_ROTATION
   421: 0000E5   D01B  rcall STOP_MOTORS
   422: 0000E6   C004  rjmp END_ROT
   423: 
   424: ROTATION_3:
   425: ;Gira mais uma vez para a direita, se direcionando no sentido oposto do qual veio antes da primeira detecção de obstáculo
   426: 0000E7   D01E  rcall TURN_RIGHT
   427: 0000E8   D027  rcall WAIT_ROTATION
   428: 0000E9   D017  rcall STOP_MOTORS
   429: 0000EA   C000  rjmp END_ROT
   430: 
   431: 
   432: END_ROT:
   433: 0000EB   9563  inc ROT_COUNT		;Aumenta o número de rotações realizadas
   434: 0000EC   9508  ret
   435: 
   436: 
   437: ;//////////// LOOP DE DELAY ENTRE MEDIÇÕES ////////////////////
   438: 
   439: ;Implementação de delay de cooldown compartilhada entre o sensor ultrassônico (entre medições) e os motores (antes de trocar de direção)
   440: ;Número de ms da espera é carregado em r16 antes da chamada da subrotina
   441: 
   442: ESPERA_MS:
   443: 0000ED   930F  push    r16
   444: 0000EE   931F  push    r17
   445: 0000EF   932F  push    r18
   446: 
   447: LOOP_MS:
   448: 0000F0   E118  ldi     r17, 24
   449: 
   450: LOOP_4:
   451: 0000F1   EF2A  ldi     r18, 250
   452: 
   453: LOOP_250:
   454: 0000F2   952A  dec     r18
   455: 0000F3   F7F1  brne    LOOP_250
   456: 0000F4   951A  dec     r17
   457: 0000F5   F7D9  brne    LOOP_4
   458: 0000F6   950A  dec     r16
   459: 0000F7   F7C1  brne    LOOP_MS
   460: 0000F8   912F  pop     r18
   461: 0000F9   911F  pop     r17
   462: 0000FA   910F  pop     r16
   463: 0000FB   9508  ret
   464: 
   465: 
   466: ;//////////////////// AÇÕES DOS MOTORES /////////////////////////////
   467: 
   468: ;SRs que podem ser chamadas tanto pelo funcionamento automático quanto pelos comandos via bluetooth
   469: 
   470: ;--- FRENTE: as duas rodas "para frente" (carrinho avança) --------------------
   471: ; Com motores espelhados, "ambas para frente" corresponde a rotacoes FISICAS
   472: ; opostas (uma roda horario, outra anti-horario) -> exatamente sua descricao.
   473: 
   474: RUN_MOTORS:
   475: 0000FC   9A5A  sbi PORTD, LIN1
   476: 0000FD   985B  cbi PORTD, LIN2
   477: 0000FE   9A5C  sbi PORTD, RIN1
   478: 0000FF   985D  cbi PORTD, RIN2
   479: 000100   9508  ret
   480: 
   481: 
   482: ;--- PARADO: desliga as 4 chaves (motores em roda-livre) ----------------------
   483: 
   484: STOP_MOTORS:
   485: 000101   985A  cbi PORTD, LIN1
   486: 000102   985B  cbi PORTD, LIN2
   487: 000103   985C  cbi PORTD, RIN1
   488: 000104   985D  cbi PORTD, RIN2
   489: 000105   9508  ret
   490: 
   491: ;--- GIRO DIREITA (no proprio eixo): roda E p/ frente, roda D p/ tras ---------
   492: ; resultado: carrinho gira no sentido horario (visto de cima) = vira p/ direita
   493: 
   494: TURN_RIGHT:
   495: 000106   9A5A  sbi PORTD, LIN1
   496: 000107   985B  cbi PORTD, LIN2
   497: 000108   985C  cbi PORTD, RIN1
   498: 000109   9A5D  sbi PORTD, RIN2
   499: 00010A   9508  ret
   500: 
   501: 
   502: ;--- GIRO ESQUERDA (no proprio eixo): roda E p/ tras, roda D p/ frente --------
   503: 
   504: TURN_LEFT:
   505: 00010B   985A  cbi PORTD, LIN1
   506: 00010C   9A5B  sbi PORTD, LIN2
   507: 00010D   9A5C  sbi PORTD, RIN1
   508: 00010E   985D  cbi PORTD, RIN2
   509: 00010F   9508  ret
   510: 
   511: ;--- DELAY ROTAÇÃO: espera um tempo com o motor rotacionando ---------
   512: 
   513: WAIT_ROTATION:
   514: 
   515: 000110   2700  clr r16
   516: 000111   9300  sts TCNT1H, r16
        000112   0085
   517: 000113   9300  sts TCNT1L, r16     ;zera o timer 1
        000114   0084
   518: 
   519: ;ldi r16, (1<<CS12)|(1<<CS10)
   520: 000115   E00D  ldi r16, (1<<WGM12)|(1<<CS12)|(1<<CS10)
   521: 000116   9300  sts TCCR1B,r16			;Configura PS 1024, iniciando contagem (interrupção no match do comparador A do timer 1)
        000117   0081
   522: 
   523: wait_interrupt:
   524: 000118   115C  cpse TIMER1_FLAG, r12   ;Verifica se a interrupção foi ativada
   525: 000119   CFFE  rjmp wait_interrupt
   526: 
   527: ;Após ser ativada, encerra a SR de espera, desativando o timer
   528: 00011A   2755  clr TIMER1_FLAG
   529: 00011B   E008  ldi r16,(1<<WGM12)
   530: 00011C   9300  sts TCCR1B,r16
        00011D   0081
   531: 00011E   9508  ret
   532: 
   533: 
   534: ;--- AJUSTE DE VELOCIDADE: altera o valor do comparador A do timer0 ---------
   535: 
   536: SPEED_UP:
   537: 00011F   3072  cpi SPEED_REG,0x02
   538: 000120   F099  breq no_change		;Verifica se já está no limite superior e pula o incremento e ajuste caso sim
   539: 000121   9573  inc SPEED_REG
   540: 000122   C004  rjmp adjust_pwm
   541: 
   542: 
   543: SPEED_DOWN:
   544: 000123   3070  cpi SPEED_REG, 0x00
   545: 000124   F079  breq no_change		;Verifica se já está no limite inferior e pula o decremento e ajuste caso sim
   546: 000125   957A  dec SPEED_REG
   547: 000126   C000  rjmp adjust_pwm
   548: 
   549: adjust_pwm:
   550: ;Determina o valor de PWM para passar para OCR0A com base no valor de SPEED_REG (0,1 ou 2)
   551: 000127   3070  cpi SPEED_REG, 0x00
   552: 000128   F029  breq set_slow
   553: 000129   3071  cpi SPEED_REG, 0x01
   554: 00012A   F031  breq set_medium
   555: 
   556: ;Se não der branch nas duas, é para setar em fast
   557: 00012B   EF0F  ldi r16, DUTY_FAST
   558: 00012C   BD07  out OCR0A,r16		;Passa o valor definido para o comparador A do timer0
   559: 00012D   9508  ret
   560: 
   561: set_slow:
   562: 00012E   E50A  ldi r16, DUTY_SLOW
   563: 00012F   BD07  out OCR0A, r16
   564: 000130   9508  ret
   565: 
   566: set_medium:
   567: 000131   EA00  ldi r16, DUTY_STD
   568: 000132   BD07  out OCR0A, r16
   569: 000133   9508  ret
   570: 
   571: no_change:
   572: 000134   9508  ret			;Caso seja um comando que não possa ser executado, só retorna
   573: 
   574: 
   575: ;////////////////////////// SUB-ROTINAS DE INTERRUPÇÃO /////////////////////////////////
   576: 
   577: ;Compare match do Timer 1 -> Delay de rotação dos motores
   578: 
   579: INT_TIMER1_COMPA:
   580: 000135   E051  ldi TIMER1_FLAG, 0x01  ;Sinalizador de que a interrupção foi ativada
   581: 000136   9518  reti
   582: 
   583: ;SR de quando chega um dado no RX do USART
   584: 
   585: INT_RX_USART:
   586: 
   587: ;Salva os dados caso esteja no meio de uma operação quando a interrupção for ativada
   588: 000137   930F  push r16
   589: 000138   B70F  in   r16, SREG  ; Lê o registrador de Status
   590: 000139   930F  push r16        ; Salva o SREG na pilha
   591: 00013A   931F  push r17
   592: 00013B   932F  push r18
   593: 00013C   933F  push r19
   594: 00013D   934F  push r20
   595: 00013E   93EF  push ZL
   596: 00013F   93FF  push ZH
   597: 
   598: ;Tratamento de erros
   599: 000140   9100  lds     r16, UCSR0A
        000141   00C0
   600: 000142   2F20  mov     r18, r16
   601: 000143   712C  andi    r18, (1<<FE0) | (1<<DOR0) | (1<<UPE0)
   602: 
   603: ;Lê a mensagem recebida
   604: 000144   9110  lds     r17, UDR0
        000145   00C6
   605: ; Se houve erro de frame / overrun / paridade: vai para o fim descartar
   606: 000146   2322  tst     r18
   607: 000147   F419  brne    end_sri
   608: 
   609: ; Filtra caracteres de controle ASCII (valor < 0x20)
   610: 000148   3210  cpi     r17, 0x20
   611: 000149   F008  brlo    end_sri         ; se for menor, pula o processamento e encerra a interrupção, esperando próximo caracter (se houver)
   612: 
   613: 00014A   D00A  rcall  process_command
   614: 
   615: end_sri:
   616: ;Recupera os valores originais na ordem inversa do push
   617: 00014B   91FF  pop ZH
   618: 00014C   91EF  pop ZL
   619: 00014D   914F  pop r20
   620: 00014E   913F  pop r19
   621: 00014F   912F  pop r18
   622: 000150   911F  pop r17
   623: 000151   910F  pop r16         ; Recupera o SREG antigo em r16
   624: 000152   BF0F  out SREG, r16   ; Devolve o SREG ao seu lugar
   625: 000153   910F  pop r16         ; Recupera o r16 original do main
   626: 
   627: 000154   9518  reti
   628: 
   629: 
   630: ;////////////// SR DE PROCESSAMENTO DO SINAL ////////////////////////////
   631: 
   632: process_command:
   633: 
   634: 000155   ECEA  ldi     ZL,low(command_table << 1)
   635: 000156   E0F2  ldi     ZH,high(command_table <<1) ;Carrega o endereço da tabela de comandos no ponteiro Z
   636:                                    ;multiplicamos o endereço por 2 (<< 1) porque a Flash é organizada em Words (16 bits)
   637: 
   638: search_loop:
   639: 
   640: 000157   9125  lpm   r18,Z+   ;Lê o caracter da tabela e incrementa o ponteiro Z
   641: 
   642: 000158   3020  cpi   r18,0X00 ;Determina se chegou no fim da tabela (null terminator)
   643: 000159   F021  breq  invalid_command
   644: 
   645: 00015A   1721  cp    r18,r17  ;Compara o caracter da tabela com o recebido
   646: 00015B   F019  breq  found_command
   647: 
   648: 00015C   9633  adiw  ZL, 3        ;Se ainda não deu match, segue percorrendo a tabela após incrementar o ponteiro em 3 bytes
   649: 00015D   CFF9  rjmp  search_loop
   650: 
   651: invalid_command:
   652: 00015E   9508  ret
   653: 
   654: found_command:
   655: 00015F   9631  adiw  ZL,1        ;Pula o byte de padding (0xFF)
   656: 000160   9145  lpm   r20,Z+      ;Salva byte alto do endereço da SR em r20
   657: 000161   9134  lpm   r19,Z       ;Salva byte baixo do endereço da SR em r19
   658: 
   659: 000162   2FF4  mov ZH, R20
   660: 000163   2FE3  mov ZL, R19
   661: 
   662: 000164   9409  ijmp              ;Salta para o endereço em Z (subrotina da ação dos motores)
   663: 
   664: ;Vai dar ret dentro da SR específica
   665: 
   666: 
   667: ;////////////// LOOKUP TABLE DOS COMANDOS ///////////////////////////
   668: 
   669: command_table:
   670: 
   671: .db CMD_GO,	        0xFF, high(BT_GO),  low(BT_GO)
        000165 FF47 7101
   672: .db CMD_STOP,       0xFF, high(BT_STOP), low(BT_STOP)
        000167 FF53 6E01
   673: .db CMD_SPEED_UP,   0xFF, high(SPEED_UP),    low(SPEED_UP)
        000169 FF2B 1F01
   674: .db CMD_SPEED_DOWN, 0xFF, high(SPEED_DOWN),  low(SPEED_DOWN)
        00016B FF2D 2301
   675: 
   676: ;A avaliar se serão incluídos
   677: ;.db CMD_FORWARD,    0xFF, high(run_forward), low(run_forward)
   678: ;.db CMD_BACK,       0xFF, high(run_back),    low(run_back)
   679: ;.db CMD_LEFT,       0xFF, high(turn_left),   low(turn_left)
   680: ;.db CMD_RIGHT,      0xFF, high(turn_right),  low(turn_right)
   681: 
   682: 
   683: .db 0x00,0x00       ;demarcador de fim da tabela
        00016D 0000
   684: 
   685: ;////////////  SRs específicas bluetooth //////////////////////
   686: 
   687: BT_STOP:
   688: 00016E   2788  clr CAR_STATE
   689: 00016F   DF91  rcall STOP_MOTORS
   690: 000170   9508  ret
   691: 
   692: BT_GO:
   693: 000171   E081  ldi CAR_STATE,0x01
   694: 000172   DF89  rcall RUN_MOTORS
   695: 000173   9508  ret
   696: 
   697: 
   698: 
   699: ;END
