     6: ;///////////////// CONSTANTES E PINAGEM ///////////////////////
     7: 
     8: ;PODEMOS REDEFINIR OS PARÂMETROS AQUI FACILMENTE, SEM MEXER NO CORPO DO CÓDIGO
     9: 
    10: 
    11: ;PINOS
    12: 
    13: ; Ponte-H ESQUERDA (Motor E)         Ponte-H DIREITA (Motor D)
    14: ;   PD2 = IN1 (E)                      PD4 = IN1 (D)
    15: ;   PD3 = IN2 (E)                      PD5 = IN2 (D)
    16: 
    17: ; Convencao por roda: IN1=1,IN2=0 -> "frente"  |  IN1=0,IN2=1 -> "tras"
    18: 
    19: .equ LIN1 = PD2
    20: .equ LIN2 = PD3
    21: .equ RIN1 = PD4
    22: .equ RIN2 = PD5
    23: .equ PWM_PIN = PD6 ; PWM VELOCIDADE (saida OC0A do Timer0) -> ligar FISICAMENTE em ENA E ENB
    24: 
    25: ; SENSOR ULTRASSÔNICO
    26: 
    27: .equ TRIG = PB4
    28: .equ ECHO = PB3
    29: 
    30: ;COMUNICAÇÃO USART MÓDULO BLUETOOTH
    31: 
    32: .equ RX = PD0
    33: .equ TX = PD1
    34: 
    35: ; CONSTANTES
    36: 
    37: ;MODOS DE VELOCIDADE DO MOTOR
    38: 
    39: .equ DUTY_SLOW = 90       ; ~35% (SPEED_REG -> 0)
    40: .equ DUTY_STD  = 160      ; ~63% (SPEED_REG -> 1)
    41: .equ DUTY_FAST = 255      ; 100% (SPEED_REG -> 2)
    42: 
    43: ;Delay de rotação dos motores (durante a rotação) -> 400ms
    44: .equ ROT_DELAY = 6250 		;Número de contagens com PS de 1024 -> N = T_DELAY(s) * (16M/PS)
    45: 
    46: ;Delay pré-rotação para o carrinho parar
    47: .equ STOP_DELAY_MS = 150;
    48: 
    49: 
    50: ;Baud rate comunicação USART:
    51: .equ 	UBRR_VAL = 103 ; define constante representando o baud rate da comunicação UART em 9600bps
    52:                        ; UBRR_VAL = (f_clk/(16*baud_rate)) - 1
    53: 
    54: ;Comandos bluetooth
    55: 
    56: .equ CMD_FORWARD    = 0x46     ; F
    57: .equ CMD_BACK       = 0x42     ; B
    58: .equ CMD_LEFT       = 0x4C     ; L
    59: .equ CMD_RIGHT      = 0x52     ; R
    60: .equ CMD_GO	    = 0x47     ; G
    61: .equ CMD_STOP       = 0x53     ; S
    62: .equ CMD_SPEED_UP   = 0x2B     ; +
    63: .equ CMD_SPEED_DOWN = 0x2D     ; -
    64: 
    65: 
    66: 
    67: 
    68: ;Distância de alcance sensor
    69: .equ    LIMIAR_CM = 10
    70: 
    71: ;Variável de registro de ocorrência de interrupção do comparadorA
    72: .def TIMER1_FLAG = r21
    73: 
    74: ;Variável de controle de mudanças de direção realizadas (incrementada a cada rotação sucessiva e é zerado quando o carro pode seguir em frente)
    75: .def ROT_COUNT = r22
    76: 
    77: ;Variável de registro de controle de PWM
    78: .def SPEED_REG = r23
    79: 
    80: ;Variável de controle do estado do carrinho (IDLE ou RUNNING)
    81: .def CAR_STATE = r24
    82: 
    83: ; CAR_STATE = 1 -> RUNNING
    84: ; CAR_STATE = 0 -> IDLE
    85: 
    86: ;////////////// VETORES DE INTERRUPÇÃO ///////////////////////////////
    87: 
    88: .cseg
    89: .org 0x0000
