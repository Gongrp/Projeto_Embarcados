   231: ;////////////////////// SUB-ROTINAS //////////////////////////////////
   232: 
   233: DISPARA_TRIGGER:
   234: 000078   9A2C  sbi     PORTB, TRIG
   235: ;10us a 16MHz = 160 ciclos de clock
   236: 000079   E312  ldi     r17, 50
   237: 
   238: PULSO_TRIG: ;Aguarda 10 microsseg com TRIG em HIGH (delay implementado com decremento)
   239: 00007A   0000  nop
   240: 00007B   0000  nop
   241: 00007C   951A  dec     r17
   242: 00007D   F7E1  brne    PULSO_TRIG
   243: 00007E   982C  cbi     PORTB, TRIG
   244: 00007F   9508  ret
   245: 
   246: 
   247: ; Aguarda o pino ECHO ir para nível alto.
   248: ; Retorna: Carry = 1 se houve timeout (sem resposta do sensor)
   249: ;          Carry = 0 se ECHO subiu normalmente
   250: 
   251: ESPERA_ECHO_SUBIR:
   252: 000080   2722  clr r18           ; contador de timeout (256 voltas)
   253: 000081   9320  sts TCNT2,r18
        000082   00B2
   254: 000083   E021  ldi r18,(1<<TOV2)
   255: 000084   BB27  out TIFR2,r18      ; limpa flag pendente (escreve 1 para limpar)
   256: 000085   E026  ldi r18, (1<<CS22)|(1<<CS21)
   257: 000086   9320  sts TCCR2B,r18      ; inicia Timer2 com prescaler 256
        000087   00B1
   258: 
   259: LACO_ESPERA_SUBIDA:
   260: 000088   991B  sbic    PINB, ECHO    ; se ECHO=0, pula a próxima linha
   261: 000089   C009  rjmp    ECHO_OK_SUBIU
   262: 00008A   B327  in      r18,TIFR2
   263: 00008B   FD20  sbrc    R18,TOV2
   264: 00008C   C001  rjmp    TIMEOUT_SUBIDA
   265: 00008D   CFFA  rjmp    LACO_ESPERA_SUBIDA
   266: 
   267: TIMEOUT_SUBIDA:
   268: 00008E   2722  clr     r18
   269: 00008F   9320  sts     TCCR2B, r18       ; para o timer
        000090   00B1
   270: 000091   9408  sec                       ; timeout
   271: 000092   9508  ret
   272: 
   273: ECHO_OK_SUBIU:
   274: 000093   9488  clc                         ; limpa carry = sucesso
   275: 000094   9508  ret
   276: 
   277: 
   278: ;/////// CRONOMETRA_ECHO /////////////////////
   279: 
   280: ; Usa Timer2 com PS de 256 para contar quanto tempo o pino ECHO permanece em nível alto.
   281: 
   282: CRONOMETRA_ECHO:
   283: 000095   2700  clr     r16
   284: 000096   9300  sts     TCCR2B,r16 ;para o timer
        000097   00B1
   285: 000098   9300  sts     TCNT2, r16 ;zera o contador
        000099   00B2
   286: 00009A   E001  ldi     r16, (1<<TOV2)
   287: 00009B   BB07  out     TIFR2, r16         ; limpa flag pendente
   288: 
   289: ; Liga Timer2 com prescaler 256
   290: 00009C   E006  ldi     r16, (1<<CS22) | (1<<CS21)
   291: 00009D   9300  sts     TCCR2B, r16
        00009E   00B1
   292: 
   293: 
   294: ESPERA_ECHO_DESCER:
   295: 00009F   9B1B  sbis    PINB, ECHO
   296: 0000A0   C009  rjmp    ECHO_DESCEU_OK
   297: 0000A1   B307  in      r16, TIFR2
   298: 0000A2   FD00  sbrc    r16, TOV2  ;Pula para repetir o loop de espera enquanto não há overflow
   299: 0000A3   C001  rjmp    TIMEOUT_DESCIDA
   300: 0000A4   CFFA  rjmp    ESPERA_ECHO_DESCER
   301: 
   302: TIMEOUT_DESCIDA:
   303: ; TIMEOUT: para o timer e retorna distância máxima como indicador de timeout
   304: 0000A5   2700  clr     r16
   305: 0000A6   9300  sts     TCCR2B,r16
        0000A7   00B1
   306: 0000A8   EF4F  ldi     r20,0xFF
   307: 0000A9   9508  ret
   308: 
   309: 
   310: ECHO_DESCEU_OK:
   311: 0000AA   2700  clr     r16
   312: 0000AB   9300  sts     TCCR2B, r16 ;Para o timer2
        0000AC   00B1
   313: 
   314: 0000AD   9140  lds     r20, TCNT2    ;Lê valor de tempo de demora da detecção (será depois convertido em cm)
        0000AE   00B2
   315: 0000AF   9508  ret
   316: 
   317: ;//////////////////CONVERSÃO PARA CM ///////////////////////////////
   318: 
   319: ;OBS.: ADICIONAR FÓRMULA DE CONVERSÃO PARA CM
   320: 
   321: CONVERTE_PARA_CM:
   322: 0000B0   930F  push    R16
   323: 0000B1   931F  push    R17
   324: 0000B2   932F  push    R18
   325: 0000B3   920F  push    r0
   326: 0000B4   921F  push    r1
   327: 
   328: 0000B5   2F14  mov     r17, r20      ; Move o valor da distância para r17
   329: 0000B6   E00A  ldi     r16, 10
   330: 0000B7   9F10  mul     r17, r16        ; R1:R0 = ticks(tempo) * 10 (até 2550, 16 bits é suficiente)
   331: 0000B8   2D00  mov     r16, r0           ; r16 = byte baixo do produto
   332: 0000B9   2D21  mov     r18, r1           ; r18 = byte alto do produto
   333: 
   334: ; Divide o valor de 16 bits (r18:r16) por 36
   335: ; por subtração repetida, contando em r20
   336: 
   337: 0000BA   2744  clr     r20
   338: 
   339: DIV_LOOP:
   340: 0000BB   2322  tst     r18
   341: 0000BC   F411  brne    DIV_SUBTRAI         ; byte alto != 0 -> valor >= 256 >= 36
   342: 0000BD   3204  cpi     r16, 36
   343: 0000BE   F028  brlo    DIV_FIM             ; byte alto = 0 e baixo < 36 -> terminou
   344: 
   345: DIV_SUBTRAI:
   346: 0000BF   5204  subi    r16, 36
   347: 0000C0   F408  brcc    DIV_SEM_EMPRESTIMO
   348: 0000C1   952A  dec     r18               ; houve "borrow", ajusta byte alto
   349: 
   350: DIV_SEM_EMPRESTIMO:
   351: 0000C2   9543  inc     r20
   352: 0000C3   CFF7  rjmp    DIV_LOOP
   353: 
   354: DIV_FIM:
   355: ;Retorna os valores na pilha para seus registradores e encerra divisão
   356: 0000C4   901F  pop     r1
   357: 0000C5   900F  pop     r0
   358: 0000C6   912F  pop     r18
   359: 0000C7   911F  pop     r17
   360: 0000C8   910F  pop     r16
   361: 0000C9   9508  ret
   362: 
   363: ;/////////////////// TESTE DE DISTÂNCIA /////////////////////////////
   364: 
   365: ;Compara distância em cm medida com o limiar definido para determinar se o carrinho deve rotacionar, e em qual sentido (dependendo das rotações anteriores)
   366: ;Se estiver no meio de um processo de mudança de direção e não for detectado obstáculo, reinicia o movimento para frente
   367: 
   368: AVALIA_DISTANCIA:
   369: 0000CA   304A  cpi     r20, LIMIAR_CM
   370: 
   371: ;Se o valor em r20 for MENOR que o limiar -> obstáculo detectado
   372: 0000CB   F018  brlo    CHANGE_DIRECTION
   373: 
   374: ;Se não, limpa o registrador de rotações, reativa motores e volta ao loop principal
   375: 0000CC   2766  clr ROT_COUNT
   376: 0000CD   D02A  rcall RUN_MOTORS
   377: 0000CE   9508  ret
   378: 
   379: CHANGE_DIRECTION:
   380: 0000CF   D02D  rcall STOP_MOTORS
   381: 
   382: ;Delay de segurança para esperar motores realmente pararem
   383: 0000D0   E906  ldi r16, STOP_DELAY_MS
   384: 0000D1   D017  rcall ESPERA_MS	    ;Reaproveita a mesma subrotina usada pro sensor ultrassônico
   385: 
   386: 0000D2   3060  cpi ROT_COUNT, 0x00
   387: 0000D3   F029  breq ROTATION_1
   388: 0000D4   3061  cpi ROT_COUNT, 0x01
   389: 0000D5   F039  breq ROTATION_2
   390: 0000D6   3062  cpi ROT_COUNT, 0x02
   391: 0000D7   F059  breq ROTATION_3
   392: 
   393: ;Se já estiver com o ROT_COUNT em 0x03 (encontrou obstáculo voltando a de onde veio, fica parado até detectar uma abertura)
   394: 0000D8   9508  ret	;Sem incrementar o contador de rotações
   395: 
   396: 
   397: ;Se ROT_COUNT for 0x00, segue no normal (ROTATION_1)
   398: ROTATION_1:
   399: ;Gira uma vez para a esquerda
   400: 0000D9   D02D  rcall TURN_LEFT
   401: 0000DA   D031  rcall WAIT_ROTATION
   402: 0000DB   D021  rcall STOP_MOTORS
   403: 0000DC   C00A  rjmp END_ROT
   404: 
   405: ROTATION_2:
   406: ;Gira duas vezes para a direita (sentido oposto da primeira rotação)
   407: 0000DD   D024  rcall TURN_RIGHT
   408: 0000DE   D02D  rcall WAIT_ROTATION
   409: 0000DF   D022  rcall TURN_RIGHT
   410: 0000E0   D02B  rcall WAIT_ROTATION
   411: 0000E1   D01B  rcall STOP_MOTORS
   412: 0000E2   C004  rjmp END_ROT
   413: 
   414: ROTATION_3:
   415: ;Gira mais uma vez para a direita, se direcionando no sentido oposto do qual veio antes da primeira detecção de obstáculo
   416: 0000E3   D01E  rcall TURN_RIGHT
   417: 0000E4   D027  rcall WAIT_ROTATION
   418: 0000E5   D017  rcall STOP_MOTORS
   419: 0000E6   C000  rjmp END_ROT
   420: 
   421: 
   422: END_ROT:
   423: 0000E7   9563  inc ROT_COUNT		;Aumenta o número de rotações realizadas
   424: 0000E8   9508  ret
   425: 
   426: 
   427: ;//////////// LOOP DE DELAY ENTRE MEDIÇÕES ////////////////////
   428: 
   429: ;Implementação de delay de cooldown compartilhada entre o sensor ultrassônico (entre medições) e os motores (antes de trocar de direção)
   430: ;Número de ms da espera é carregado em r16 antes da chamada da subrotina
   431: 
   432: ESPERA_MS:
   433: 0000E9   930F  push    r16
   434: 0000EA   931F  push    r17
   435: 0000EB   932F  push    r18
   436: 
   437: LOOP_MS:
   438: 0000EC   E118  ldi     r17, 24
   439: 
   440: LOOP_4:
   441: 0000ED   EF2A  ldi     r18, 250
   442: 
   443: LOOP_250:
   444: 0000EE   952A  dec     r18
   445: 0000EF   F7F1  brne    LOOP_250
   446: 0000F0   951A  dec     r17
   447: 0000F1   F7D9  brne    LOOP_4
   448: 0000F2   950A  dec     r16
   449: 0000F3   F7C1  brne    LOOP_MS
   450: 0000F4   912F  pop     r18
   451: 0000F5   911F  pop     r17
   452: 0000F6   910F  pop     r16
   453: 0000F7   9508  ret
   454: 
