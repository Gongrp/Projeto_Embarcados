   456: ;//////////////////// AÇÕES DOS MOTORES /////////////////////////////
   457: 
   458: ;SRs que podem ser chamadas tanto pelo funcionamento automático quanto pelos comandos via bluetooth
   459: 
   460: ;--- FRENTE: as duas rodas "para frente" (carrinho avança) --------------------
   461: ; Com motores espelhados, "ambas para frente" corresponde a rotacoes FISICAS
   462: ; opostas (uma roda horario, outra anti-horario) -> exatamente sua descricao.
   463: 
   464: RUN_MOTORS:
   465: 0000F8   9A5A  sbi PORTD, LIN1
   466: 0000F9   985B  cbi PORTD, LIN2
   467: 0000FA   9A5C  sbi PORTD, RIN1
   468: 0000FB   985D  cbi PORTD, RIN2
   469: 0000FC   9508  ret
   470: 
   471: 
   472: ;--- PARADO: desliga as 4 chaves (motores em roda-livre) ----------------------
   473: 
   474: STOP_MOTORS:
   475: 0000FD   985A  cbi PORTD, LIN1
   476: 0000FE   985B  cbi PORTD, LIN2
   477: 0000FF   985C  cbi PORTD, RIN1
   478: 000100   985D  cbi PORTD, RIN2
   479: 000101   9508  ret
   480: 
   481: ;--- GIRO DIREITA (no proprio eixo): roda E p/ frente, roda D p/ tras ---------
   482: ; resultado: carrinho gira no sentido horario (visto de cima) = vira p/ direita
   483: 
   484: TURN_RIGHT:
   485: 000102   9A5A  sbi PORTD, LIN1
   486: 000103   985B  cbi PORTD, LIN2
   487: 000104   985C  cbi PORTD, RIN1
   488: 000105   9A5D  sbi PORTD, RIN2
   489: 000106   9508  ret
   490: 
   491: 
   492: ;--- GIRO ESQUERDA (no proprio eixo): roda E p/ tras, roda D p/ frente --------
   493: 
   494: TURN_LEFT:
   495: 000107   985A  cbi PORTD, LIN1
   496: 000108   9A5B  sbi PORTD, LIN2
   497: 000109   9A5C  sbi PORTD, RIN1
   498: 00010A   985D  cbi PORTD, RIN2
   499: 00010B   9508  ret
   500: 
   501: ;--- DELAY ROTAÇÃO: espera um tempo com o motor rotacionando ---------
   502: 
   503: WAIT_ROTATION:
   504: 
   505: 00010C   2700  clr r16
   506: 00010D   9300  sts TCNT1H, r16
        00010E   0085
   507: 00010F   9300  sts TCNT1L, r16     ;zera o timer 1
        000110   0084
   508: 
   509: ;ldi r16, (1<<CS12)|(1<<CS10)
   510: 000111   E00D  ldi r16, (1<<WGM12)|(1<<CS12)|(1<<CS10)
   511: 000112   9300  sts TCCR1B,r16			;Configura PS 1024, iniciando contagem (interrupção no match do comparador A do timer 1)
        000113   0081
   512: 
   513: wait_interrupt:
   514: 000114   115C  cpse TIMER1_FLAG, r12   ;Verifica se a interrupção foi ativada
   515: 000115   CFFE  rjmp wait_interrupt
   516: 
   517: ;Após ser ativada, encerra a SR de espera, desativando o timer
   518: 000116   2755  clr TIMER1_FLAG
   519: 000117   E008  ldi r16,(1<<WGM12)
   520: 000118   9300  sts TCCR1B,r16
        000119   0081
   521: 00011A   9508  ret
   522: 
   523: 
   524: ;--- AJUSTE DE VELOCIDADE: altera o valor do comparador A do timer0 ---------
   525: 
   526: SPEED_UP:
   527: 00011B   3072  cpi SPEED_REG,0x02
   528: 00011C   F099  breq no_change		;Verifica se já está no limite superior e pula o incremento e ajuste caso sim
   529: 00011D   9573  inc SPEED_REG
   530: 00011E   C004  rjmp adjust_pwm
   531: 
   532: 
   533: SPEED_DOWN:
   534: 00011F   3070  cpi SPEED_REG, 0x00
   535: 000120   F079  breq no_change		;Verifica se já está no limite inferior e pula o decremento e ajuste caso sim
   536: 000121   957A  dec SPEED_REG
   537: 000122   C000  rjmp adjust_pwm
   538: 
   539: adjust_pwm:
   540: ;Determina o valor de PWM para passar para OCR0A com base no valor de SPEED_REG (0,1 ou 2)
   541: 000123   3070  cpi SPEED_REG, 0x00
   542: 000124   F029  breq set_slow
   543: 000125   3071  cpi SPEED_REG, 0x01
   544: 000126   F031  breq set_medium
   545: 
   546: ;Se não der branch nas duas, é para setar em fast
   547: 000127   EF0F  ldi r16, DUTY_FAST
   548: 000128   BD07  out OCR0A,r16		;Passa o valor definido para o comparador A do timer0
   549: 000129   9508  ret
   550: 
   551: set_slow:
   552: 00012A   E50A  ldi r16, DUTY_SLOW
   553: 00012B   BD07  out OCR0A, r16
   554: 00012C   9508  ret
   555: 
   556: set_medium:
   557: 00012D   EA00  ldi r16, DUTY_STD
   558: 00012E   BD07  out OCR0A, r16
   559: 00012F   9508  ret
   560: 
   561: no_change:
   562: 000130   9508  ret			;Caso seja um comando que não possa ser executado, só retorna
   563: 
   564: 
   565: ;////////////////////////// SUB-ROTINAS DE INTERRUPÇÃO /////////////////////////////////
   566: 
   567: ;Compare match do Timer 1 -> Delay de rotação dos motores
   568: 
   569: INT_TIMER1_COMPA:
   570: 000131   E051  ldi TIMER1_FLAG, 0x01  ;Sinalizador de que a interrupção foi ativada
   571: 000132   9518  reti
   572: 
   573: ;SR de quando chega um dado no RX do USART
   574: 
   575: INT_RX_USART:
   576: 
   577: ;Salva os dados caso esteja no meio de uma operação quando a interrupção for ativada
   578: 000133   930F  push r16
   579: 000134   B70F  in   r16, SREG  ; Lê o registrador de Status
   580: 000135   930F  push r16        ; Salva o SREG na pilha
   581: 000136   931F  push r17
   582: 000137   932F  push r18
   583: 000138   933F  push r19
   584: 000139   934F  push r20
   585: 00013A   93EF  push ZL
   586: 00013B   93FF  push ZH
   587: 
   588: ;Tratamento de erros
   589: 00013C   9100  lds     r16, UCSR0A
        00013D   00C0
   590: 00013E   2F20  mov     r18, r16
   591: 00013F   712C  andi    r18, (1<<FE0) | (1<<DOR0) | (1<<UPE0)
   592: 
   593: ;Lê a mensagem recebida
   594: 000140   9110  lds     r17, UDR0
        000141   00C6
   595: ; Se houve erro de frame / overrun / paridade: vai para o fim descartar
   596: 000142   2322  tst     r18
   597: 000143   F419  brne    end_sri
   598: 
   599: ; Filtra caracteres de controle ASCII (valor < 0x20)
   600: 000144   3210  cpi     r17, 0x20
   601: 000145   F008  brlo    end_sri         ; se for menor, pula o processamento e encerra a interrupção, esperando próximo caracter (se houver)
   602: 
   603: 000146   D00A  rcall  process_command
   604: 
   605: end_sri:
   606: ;Recupera os valores originais na ordem inversa do push
   607: 000147   91FF  pop ZH
   608: 000148   91EF  pop ZL
   609: 000149   914F  pop r20
   610: 00014A   913F  pop r19
   611: 00014B   912F  pop r18
   612: 00014C   911F  pop r17
   613: 00014D   910F  pop r16         ; Recupera o SREG antigo em r16
   614: 00014E   BF0F  out SREG, r16   ; Devolve o SREG ao seu lugar
   615: 00014F   910F  pop r16         ; Recupera o r16 original do main
   616: 
   617: 000150   9518  reti
   618: 
   619: 
   620: ;////////////// SR DE PROCESSAMENTO DO SINAL ////////////////////////////
   621: 
   622: process_command:
   623: 
   624: 000151   ECE2  ldi     ZL,low(command_table << 1)
   625: 000152   E0F2  ldi     ZH,high(command_table <<1) ;Carrega o endereço da tabela de comandos no ponteiro Z
   626:                                    ;multiplicamos o endereço por 2 (<< 1) porque a Flash é organizada em Words (16 bits)
   627: 
   628: search_loop:
   629: 
   630: 000153   9125  lpm   r18,Z+   ;Lê o caracter da tabela e incrementa o ponteiro Z
   631: 
   632: 000154   3020  cpi   r18,0X00 ;Determina se chegou no fim da tabela (null terminator)
   633: 000155   F021  breq  invalid_command
   634: 
   635: 000156   1721  cp    r18,r17  ;Compara o caracter da tabela com o recebido
   636: 000157   F019  breq  found_command
   637: 
   638: 000158   9633  adiw  ZL, 3        ;Se ainda não deu match, segue percorrendo a tabela após incrementar o ponteiro em 3 bytes
   639: 000159   CFF9  rjmp  search_loop
   640: 
   641: invalid_command:
   642: 00015A   9508  ret
   643: 
   644: found_command:
   645: 00015B   9631  adiw  ZL,1        ;Pula o byte de padding (0xFF)
   646: 00015C   9145  lpm   r20,Z+      ;Salva byte alto do endereço da SR em r20
   647: 00015D   9134  lpm   r19,Z       ;Salva byte baixo do endereço da SR em r19
   648: 
   649: 00015E   2FF4  mov ZH, R20
   650: 00015F   2FE3  mov ZL, R19
   651: 
   652: 000160   9409  ijmp              ;Salta para o endereço em Z (subrotina da ação dos motores)
   653: 
   654: ;Vai dar ret dentro da SR específica
   655: 
   656: 
   657: ;////////////// LOOKUP TABLE DOS COMANDOS ///////////////////////////
   658: 
   659: command_table:
   660: 
   661: .db CMD_GO,	    0xFF, high(RUN_MOTORS),  low(RUN_MOTORS)
        000161 FF47 F800
   662: .db CMD_STOP,       0xFF, high(STOP_MOTORS), low(STOP_MOTORS)
        000163 FF53 FD00
   663: .db CMD_SPEED_UP,   0xFF, high(SPEED_UP),    low(SPEED_UP)
        000165 FF2B 1B01
   664: .db CMD_SPEED_DOWN, 0xFF, high(SPEED_DOWN),  low(SPEED_DOWN)
        000167 FF2D 1F01
   665: 
   666: ;A avaliar se serão incluídos
   667: ;.db CMD_FORWARD,    0xFF, high(run_forward), low(run_forward)
   668: ;.db CMD_BACK,       0xFF, high(run_back),    low(run_back)
   669: ;.db CMD_LEFT,       0xFF, high(turn_left),   low(turn_left)
   670: ;.db CMD_RIGHT,      0xFF, high(turn_right),  low(turn_right)
   671: 
   672: 
   673: .db 0x00,0x00       ;demarcador de fim da tabela
        000169 0000
   674: 
   675: 
   676: 
   677: 
   678: 
   679: ;END
