   202: ;////////////////// CÓDIGO PRINCIPAL ///////////////////////////////
   203: 
   204: ;loop principal -> Realiza o processo de medição com o sensor ultrassônico e determina se o carrinho deve mudar de direção
   205: 
   206: main:
   207: 
   208: ;OBS.: SE NECESSÁRIO, INCORPORAR DEPOIS FILTRO MÉDIA MÓVEL PARA AS MEDIDAS DO ULTRASSONICO
   209: 00006C   D00B  rcall   DISPARA_TRIGGER
   210: 00006D   D012  rcall   ESPERA_ECHO_SUBIR
   211: 00006E   F020  brcs    SEM_ECO              ; carry=1 -> sensor não respondeu
   212: 
   213: 00006F   D025  rcall   CRONOMETRA_ECHO
   214: 000070   D03F  rcall   CONVERTE_PARA_CM
   215: 000071   D058  rcall   AVALIA_DISTANCIA
   216: 000072   C002  rjmp 	COOLDOWN
   217: 
   218: SEM_ECO:
   219: 000073   EF4F  ldi     r20, 0xFF        ; valor alto = "livre"
   220: 000074   D055  rcall AVALIA_DISTANCIA
   221: 
   222: COOLDOWN:
   223: ; pausa entre medições (~80ms, recomendado pelo datasheet)
   224: 000075   E500  ldi     r16, 80
   225: 000076   D072  rcall   ESPERA_MS
   226: 
   227: 000077   CFF4  rjmp   main; Reinicia loop principal
