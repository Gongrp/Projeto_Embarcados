   101: ;////////////// CONFIGURAÇÕES INICIAIS //////////////////////////
   102: 
   103: .org 0x0034
   104: config:
   105: 
   106: ;Inicializando SP
   107: 000034   EF0F  ldi     R16,LOW(RAMEND)
   108: 000035   BF0D  out     SPL,R16
   109: 000036   E008  ldi     R16,HIGH(RAMEND)
   110: 000037   BF0E  out     SPH,R16
   111: 
   112: ;Configurações iniciais de registradores
   113: 
   114: ;Constante de comparação para sinalizar ativação de interrupts
   115: 000038   E001  ldi r16, 0x01
   116: 000039   2EC0  mov r12, r16
   117: 
   118: ;Guarda a velocidade padrão como a configuração inicial
   119: 00003A   E071  ldi SPEED_REG, 0x01
   120: 
   121: 00003B   2766  clr ROT_COUNT ;Inicia a contagem de rotações em zero
   122: 
   123: 00003C   E081  ldi CAR_STATE, 0x01 ; Inicia com carrinho rodando
   124: 
   125: 00003D   E091  ldi r25, 0x01       ;Registrador de comparação para avaliar o estado do carrinho (IDLE OU RUNNING)
   126: 
   127: ;Configuração das portas
   128: 
   129: ;PORTD:
   130: 00003E   E70C  ldi r16, (1<<LIN1)|(1<<LIN2)|(1<<RIN1)|(1<<RIN2)|(1<<PWM_PIN)
   131: 00003F   B90A  out DDRD, r16
   132: 000040   2700  clr r16
   133: 000041   B90B  out PORTD, r16
   134: ;Define todos os pinos dos motores como saída, zera os valores nas portas
   135: 
   136: ;PORTB:
   137: 000042   E100  ldi r16, (1<<TRIG)
   138: 000043   B904  out DDRB,r16
   139: 000044   2700  clr r16
   140: 000045   B905  out PORTB,r16
   141: ;Define o pino do TRIG como saída e o do ECHO como entrada, zera os valores nas portas
   142: 
   143: ;Configuração dos timers
   144: 
   145: ;TIMER0 -> PWM velocidade dos motores
   146: 
   147: 000046   E803  ldi r16, (1<<COM0A1)|(1<<WGM01)|(1<<WGM00)
   148: 000047   BD04  out TCCR0A,r16                              ;Configura timer0 no modo fast pwm, conecta comparador A no modo não inversor
   149: 000048   E003  ldi r16, (1<<CS01)|(1<<CS00)
   150: 000049   BD05  out TCCR0B,r16				    ;Configura PS 64
   151: 
   152: 
   153: ;TIMER1 -> Delay de rotação do motor
   154: 
   155: ;ldi r16, (1<<COM1A1)|(1<<WGM11)
   156: 00004A   2700  clr r16
   157: 00004B   9300  sts TCCR1A,r16                  ;Configura timer 1 no modo CTC conectando comparador A no modo não inversor
        00004C   0080
   158: 00004D   E008  ldi r16, (1<<WGM12)
   159: 00004E   9300  sts TCCR1B,r16			            ;Timer inicia desativado
        00004F   0081
   160: 000050   E108  ldi r16, high(ROT_DELAY)
   161: 000051   9300  sts OCR1AH,r16			;Salva no comparador o número de contagens definido pelo delay desejado -> Determina ângulo de rotação
        000052   0089
   162: 000053   E60A  ldi r16, low(ROT_DELAY)
   163: 000054   9300  sts OCR1AL,r16
        000055   0088
   164: 
   165: 
   166: 
   167: ;TIMER2 -> Detecção do sensor ultrassônico (tempo entre emissão no TRIG e recepção no ECHO)
   168: 
   169: 000056   E000  ldi r16,0x00
   170: 000057   9300  sts TCCR2A,r16 	   ;Configura timer 2 no modo normal (delay)
        000058   00B0
   171: 000059   9300  sts TCCR2B,r16     ;Timer2 inicia desativado
        00005A   00B1
   172: 
   173: ;Configuração das interrupções:
   174: 
   175: ;Interrupt do timer 1
   176: 00005B   E002  ldi r16, (1<<OCIE1A)
   177: 00005C   9300  sts TIMSK1,r16
        00005D   006F
   178: 
   179: ;Interrupção do bluetooth é definido em seguida
   180: 00005E   9478  sei	;Ativa enable global
   181: 
   182: ;Configuração da comunicação USART (bluetooth)
   183: 
   184: ;Configuração baud rate (taxa de comunicação -> 9,6 kbps)
   185: 00005F   E000  ldi     r16,HIGH(UBRR_VAL)
   186: 000060   9300  sts     UBRR0H,r16
        000061   00C5
   187: 000062   E607  ldi     r16,LOW(UBRR_VAL)
   188: 000063   9300  sts     UBRR0L,r16
        000064   00C4
   189: 
   190: ;Habilitação do RX do UART0 e interrupção
   191: 000065   E900  ldi     r16,(1<<RXEN0)|(1<<RXCIE0)
   192: 000066   9300  sts     UCSR0B,r16			;Ativa o RX do USART e sua respectiva interrupção (ativa quando há um dado a ser lido)
        000067   00C1
   193: 
   194: ;Configuração do formato do frame de comunicação
   195: 000068   E006  ldi     r16,(1<<UCSZ01)|(1<<UCSZ00)
   196: 000069   9300  sts     UCSR0C,r16;Seta os bits 2:1, definindo tamanho de caracter para 8 bits
        00006A   00C2
   197:                   ;Configura modo assíncrono (bit7:bit6 = 00)
   198:                   ;Modo de paridade desabilitado (bit5:bit4 = 00)
   199: 
   200: 
   201: ;Inicialização dos motores em velocidade padrão
   202: 
   203: 00006B   EA00  ldi r16, DUTY_STD
   204: 00006C   BD07  out OCR0A,r16		;Define duty cycle inicial dos motores
   205: 
   206: 00006D   D08E  rcall RUN_MOTORS	;Inicia movimento para frente
