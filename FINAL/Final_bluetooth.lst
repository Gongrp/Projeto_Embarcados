   209: ;////////////////// CÓDIGO PRINCIPAL ///////////////////////////////
   210: 
   211: ;loop principal -> Realiza o processo de medição com o sensor ultrassônico e determina se o carrinho deve mudar de direção
   212: 
   213: main:
   214: 
   215: ;OBS.: SE NECESSÁRIO, INCORPORAR DEPOIS FILTRO MÉDIA MÓVEL PARA AS MEDIDAS DO ULTRASSONICO
   216: 00006E   D00B  rcall   DISPARA_TRIGGER
   217: 00006F   D012  rcall   ESPERA_ECHO_SUBIR
   218: 000070   F020  brcs    SEM_ECO              ; carry=1 -> sensor não respondeu
   219: 
   220: 000071   D025  rcall   CRONOMETRA_ECHO
   221: 000072   D03F  rcall   CONVERTE_PARA_CM
   222: 000073   D058  rcall   AVALIA_DISTANCIA
   223: 000074   C002  rjmp 	COOLDOWN
   224: 
   225: SEM_ECO:
   226: 000075   EF4F  ldi     r20, 0xFF        ; valor alto = "livre"
   227: 000076   D055  rcall AVALIA_DISTANCIA
   228: 
   229: COOLDOWN:
   230: ; pausa entre medições (~80ms, recomendado pelo datasheet)
   231: 000077   E500  ldi     r16, 80
   232: 000078   D074  rcall   ESPERA_MS
   233: 
   234: 000079   CFF4  rjmp   main; Reinicia loop principal
   235: 
