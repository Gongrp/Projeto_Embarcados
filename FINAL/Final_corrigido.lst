   323: ;/////////////////// TESTE DE DISTÂNCIA /////////////////////////////
   324: 
   325: ;Compara distância em cm medida com o limiar definido para determinar se o carrinho deve rotacionar, e em qual sentido (dependendo das rotações anteriores)
   326: ;Se estiver no meio de um processo de mudança de direção e não for detectado obstáculo, reinicia o movimento para frente
   327: 
   328: AVALIA_DISTANCIA:
   329: 0000BD   304A  cpi     r20, LIMIAR_CM
   330: 
   331: ;Se o valor em r20 for MENOR que o limiar -> obstáculo detectado
   332: 0000BE   F018  brlo    CHANGE_DIRECTION
   333: 
   334: ;Se não, limpa o registrador de rotações, reativa motores e volta ao loop principal
   335: 0000BF   2766  clr ROT_COUNT
   336: 0000C0   D028  rcall RUN_MOTORS
   337: 0000C1   9508  ret
   338: 
   339: CHANGE_DIRECTION:
   340: 0000C2   D02B  rcall STOP_MOTORS  ;OBS.: AVALIAR SE É NECESSÁRIO INSERIR DELAY PARA PARAR TOTALMENTE
   341: 0000C3   3060  cpi ROT_COUNT, 0x00
   342: 0000C4   F029  breq ROTATION_1
   343: 0000C5   3061  cpi ROT_COUNT, 0x01
   344: 0000C6   F039  breq ROTATION_2
   345: 0000C7   3062  cpi ROT_COUNT, 0x02
   346: 0000C8   F059  breq ROTATION_3
   347: 
   348: ;Se já estiver com o ROT_COUNT em 0x03 (encontrou obstáculo voltando a de onde veio, fica parado até detectar uma abertura)
   349: 0000C9   9508  ret	;Sem incrementar o contador de rotações
   350: 
   351: 
   352: ;Se ROT_COUNT for 0x00, segue no normal (ROTATION_1)
   353: ROTATION_1:
   354: ;Gira uma vez para a esquerda
   355: 0000CA   D02D  rcall TURN_LEFT
   356: 0000CB   D031  rcall WAIT_ROTATION
   357: 0000CC   D021  rcall STOP_MOTORS
   358: 0000CD   C00A  rjmp END_ROT
   359: 
   360: ROTATION_2:
   361: ;Gira duas vezes para a direita (sentido oposto da primeira rotação)
   362: 0000CE   D024  rcall TURN_RIGHT
   363: 0000CF   D02D  rcall WAIT_ROTATION
   364: 0000D0   D022  rcall TURN_RIGHT
   365: 0000D1   D02B  rcall WAIT_ROTATION
   366: 0000D2   D01B  rcall STOP_MOTORS
   367: 0000D3   C004  rjmp END_ROT
   368: 
   369: ROTATION_3:
   370: ;Gira mais uma vez para a direita, se direcionando no sentido oposto do qual veio antes da primeira detecção de obstáculo
   371: 0000D4   D01E  rcall TURN_RIGHT
   372: 0000D5   D027  rcall WAIT_ROTATION
   373: 0000D6   D017  rcall STOP_MOTORS
   374: 0000D7   C000  rjmp END_ROT
   375: 
   376: 
   377: END_ROT:
   378: 0000D8   9563  inc ROT_COUNT		;Aumenta o número de rotações realizadas
   379: 0000D9   9508  ret
   380: 
