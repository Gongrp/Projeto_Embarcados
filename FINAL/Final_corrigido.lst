   248: 000089   9300  sts     TCCR2B,r16 ;para o timer
        00008A   00B1
   249: 00008B   9300  sts     TCNT2, r16 ;zera o contador
        00008C   00B2
   250: 00008D   E001  ldi     r16, (1<<TOV2)
   251: 00008E   BB07  out     TIFR2, r16         ; limpa flag pendente
   252: 
   253: ; Liga Timer2 com prescaler 256
   254: 00008F   E006  ldi     r16, (1<<CS22) | (1<<CS21)
   255: 000090   9300  sts     TCCR2B, r16
        000091   00B1
   256: 
   257: 
   258: ESPERA_ECHO_DESCER:
   259: 000092   9B1B  sbis    PINB, ECHO
   260: 000093   C009  rjmp    ECHO_DESCEU_OK
   261: 000094   B307  in      r16, TIFR2
   262: 000095   FD00  sbrc    r16, TOV2
   263: 000096   C001  rjmp    TIMEOUT_DESCIDA
   264: 000097   CFFA  rjmp    ESPERA_ECHO_DESCER
