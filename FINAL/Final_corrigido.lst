   411: ;//////////////////// AÇÕES DOS MOTORES /////////////////////////////
   412: 
   413: ;--- FRENTE: as duas rodas "para frente" (carrinho avança) --------------------
   414: ; Com motores espelhados, "ambas para frente" corresponde a rotacoes FISICAS
   415: ; opostas (uma roda horario, outra anti-horario) -> exatamente sua descricao.
   416: 
   417: RUN_MOTORS:
   418: 0000E9   9A5A  sbi PORTD, LIN1
   419: 0000EA   985B  cbi PORTD, LIN2
   420: 0000EB   9A5C  sbi PORTD, RIN1
   421: 0000EC   985D  cbi PORTD, RIN2
   422: 0000ED   9508  ret
   423: 
   424: 
   425: ;--- PARADO: desliga as 4 chaves (motores em roda-livre) ----------------------
   426: 
   427: STOP_MOTORS:
   428: 0000EE   985A  cbi PORTD, LIN1
   429: 0000EF   985B  cbi PORTD, LIN2
   430: 0000F0   985C  cbi PORTD, RIN1
   431: 0000F1   985D  cbi PORTD, RIN2
   432: 0000F2   9508  ret
   433: 
   434: ;--- GIRO DIREITA (no proprio eixo): roda E p/ frente, roda D p/ tras ---------
   435: ; resultado: carrinho gira no sentido horario (visto de cima) = vira p/ direita
   436: 
   437: TURN_RIGHT:
   438: 0000F3   9A5A  sbi PORTD, LIN1
   439: 0000F4   985B  cbi PORTD, LIN2
   440: 0000F5   985C  cbi PORTD, RIN1
   441: 0000F6   9A5D  sbi PORTD, RIN2
   442: 0000F7   9508  ret
   443: 
   444: 
   445: ;--- GIRO ESQUERDA (no proprio eixo): roda E p/ tras, roda D p/ frente --------
   446: 
   447: TURN_LEFT:
   448: 0000F8   985A  cbi PORTD, LIN1
   449: 0000F9   9A5B  sbi PORTD, LIN2
   450: 0000FA   9A5C  sbi PORTD, RIN1
   451: 0000FB   985D  cbi PORTD, RIN2
   452: 0000FC   9508  ret
   453: 
   454: ;--- DELAY ROTAÇÃO: espera um tempo com o motor rotacionando
   455: 
   456: WAIT_ROTATION:
   457: 
   458: 0000FD   2700  clr r16
   459: 0000FE   9300  sts TCNT1H, r16
        0000FF   0085
   460: 000100   9300  sts TCNT1L, r16     ;zera o timer 1
        000101   0084
   461: 
   462: ;ldi r16, (1<<CS12)|(1<<CS10)
   463: 000102   E00D  ldi r16, (1<<WGM12)|(1<<CS12)|(1<<CS10)
   464: 000103   9300  sts TCCR1B,r16			;Configura PS 1024, iniciando contagem (interrupção no match do comparador A do timer 1)
        000104   0081
   465: 
   466: wait_interrupt:
   467: 000105   115C  cpse TIMER1_FLAG, r12   ;Verifica se a interrupção foi ativada
   468: 000106   CFFE  rjmp wait_interrupt
   469: 
   470: ;Após ser ativada, encerra a SR de espera, desativando o timer
   471: 000107   2755  clr TIMER1_FLAG
   472: 000108   E008  ldi r16,(1<<WGM12)
   473: 000109   9300  sts TCCR1B,r16
        00010A   0081
   474: 00010B   9508  ret
   475: 
   476: 
   477: ;////////////////////////// SUB-ROTINAS DE INTERRUPÇÃO /////////////////////////////////
   478: 
   479: ;Compare match do Timer 1 -> Delay de rotação dos motores
   480: 
   481: INT_TIMER1_COMPA:
   482: 00010C   E051  ldi TIMER1_FLAG, 0x01  ;Sinalizador de que a interrupção foi ativada
   483: 00010D   9518  reti
   484: 
   485: 
   486: INT_RX_USART:
   487: ;Obs.: Preencher depois
   488: 00010E   0000  nop
   489: 00010F   9518  reti
   490: 
   491: 
   492: ;END
