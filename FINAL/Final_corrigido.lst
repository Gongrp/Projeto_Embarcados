   281: ;//////////////////CONVERSÃO PARA CM ///////////////////////////////
   282: 
   283: CONVERTE_PARA_CM:
   284: 0000A3   930F  push    R16
   285: 0000A4   931F  push    R17
   286: 0000A5   932F  push    R18
   287: 0000A6   920F  push    r0
   288: 0000A7   921F  push    r1
   289: 
   290: 0000A8   2F14  mov     r17, r20      ; r17 = ticks (0-255)
   291: 0000A9   E00A  ldi     r16, 10
   292: 0000AA   9F10  mul     r17, r16        ; R1:R0 = ticks * 10 (até 2550, 16 bits)
   293: 0000AB   2D00  mov     r16, r0           ; r16 = byte baixo do produto
   294: 0000AC   2D21  mov     r18, r1           ; r18 = byte alto do produto
   295: 
   296:         ; Divide o valor de 16 bits (r18:r16) por 36
   297:         ; por subtração repetida, contando em r20
   298: 0000AD   2744  clr     r20
   299: DIV_LOOP:
   300: 0000AE   2322  tst     r18
   301: 0000AF   F411  brne    DIV_SUBTRAI         ; byte alto != 0 -> valor >= 256 >= 36
   302: 0000B0   3204  cpi     r16, 36
   303: 0000B1   F028  brlo    DIV_FIM             ; byte alto = 0 e baixo < 36 -> terminou
   304: 
   305: DIV_SUBTRAI:
   306: 0000B2   5204  subi    r16, 36
   307: 0000B3   F408  brcc    DIV_SEM_EMPRESTIMO
   308: 0000B4   952A  dec     r18               ; houve "borrow", ajusta byte alto
   309: DIV_SEM_EMPRESTIMO:
   310: 0000B5   9543  inc     r20
   311: 0000B6   CFF7  rjmp    DIV_LOOP
   312: DIV_FIM:
   313: 
   314: 0000B7   901F  pop     r1
   315: 0000B8   900F  pop     r0
   316: 0000B9   912F  pop     r18
   317: 0000BA   911F  pop     r17
   318: 0000BB   910F  pop     r16
   319: 0000BC   9508  ret
   320: 
