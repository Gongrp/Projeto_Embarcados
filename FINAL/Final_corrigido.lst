   211: 
   212: ; Aguarda o pino ECHO ir para nível alto.
   213: ; Retorna: Carry = 1 se houve timeout (sem resposta do sensor)
   214: ;          Carry = 0 se ECHO subiu normalmente
   215: 
   216: ESPERA_ECHO_SUBIR:
   217: 000073   2722  clr r18           ; contador de timeout (256 voltas)
   218: 000074   9320  sts TCNT2,r18
        000075   00B2
   219: 000076   E021  ldi r18,(1<<TOV2)
   220: 000077   BB27  out TIFR2,r18      ; limpa flag pendente (escreve 1 para limpar)
   221: 000078   E024  ldi r18, (1<<CS22)|(1<CS21)
   222: 000079   9320  sts TCCR2B,r18      ; inicia Timer2 com prescaler 256
        00007A   00B1
   223: 
   224: LACO_ESPERA_SUBIDA:
   225: 00007B   991B  sbic    PINB, ECHO    ; se ECHO=0, pula a próxima linha
   226: 00007C   C009  rjmp    ECHO_OK_SUBIU
   227: 00007D   B327  in      r18,TIFR2
   228: 00007E   FD20  sbrc    R18,TOV2
   229: 00007F   C001  rjmp    TIMEOUT_SUBIDA
   230: 000080   F7D1  brne    LACO_ESPERA_SUBIDA
   231: 
   232: TIMEOUT_SUBIDA:
   233: 000081   2722  clr     r18
   234: 000082   9320  sts     TCCR2B, r18       ; para o timer
        000083   00B1
   235: 000084   9408  sec                          ; timeout
   236: 000085   9508  ret
   237: 
   238: ECHO_OK_SUBIU:
   239: 000086   9488  clc                         ; limpa carry = sucesso
   240: 000087   9508  ret
   241: 
   242: ; Usa Timer2 com PS de 256 para contar quanto tempo o pino ECHO permanece em nível alto.
   243: 
   244: ;/////// CRONOMETRA_ECHO /////////////////////
   245: 
   246: CRONOMETRA_ECHO:
