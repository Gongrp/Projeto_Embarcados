   382: ;//////////// LOOP DE DELAY ENTRE MEDIÇÕES ////////////////////
   383: 
   384: ;Implementação de delay de cooldown do sensor ultrassônico por decremento
   385: 
   386: ;OBS.: COGITAR ALTERAR PARA TIMER
   387: 
   388: ESPERA_MS:
   389: 0000DA   930F  push    r16
   390: 0000DB   931F  push    r17
   391: 0000DC   932F  push    r18
   392: LOOP_MS:
   393: 0000DD   E118  ldi     r17, 24
   394: LOOP_4:
   395: 0000DE   EF2A  ldi     r18, 250
   396: LOOP_250:
   397: 0000DF   952A  dec     r18
   398: 0000E0   F7F1  brne    LOOP_250
   399: 0000E1   951A  dec     r17
   400: 0000E2   F7D9  brne    LOOP_4
   401: 0000E3   950A  dec     r16
   402: 0000E4   F7C1  brne    LOOP_MS
   403: 0000E5   912F  pop     r18
   404: 0000E6   911F  pop     r17
   405: 0000E7   910F  pop     r16
   406: 0000E8   9508  ret
