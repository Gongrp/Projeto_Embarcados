   350: ;//////////////////// AÇÕES DOS MOTORES /////////////////////////////
   351: 
   352: ;--- FRENTE: as duas rodas "para frente" (carrinho avança) --------------------
   353: ; Com motores espelhados, "ambas para frente" corresponde a rotacoes FISICAS
   354: ; opostas (uma roda horario, outra anti-horario) -> exatamente sua descricao.
   355: 
   356: RUN_MOTORS:
   357: 0000BB   9A5A  sbi PORTD, LIN1
   358: 0000BC   985B  cbi PORTD, LIN2
   359: 0000BD   9A5C  sbi PORTD, RIN1
   360: 0000BE   985D  cbi PORTD, RIN2
   361: 0000BF   9508  ret
   362: 
   363: 
   364: ;--- PARADO: desliga as 4 chaves (motores em roda-livre) ----------------------
   365: 
   366: STOP_MOTORS:
   367: 0000C0   985A  cbi PORTD, LIN1
   368: 0000C1   985B  cbi PORTD, LIN2
   369: 0000C2   985C  cbi PORTD, RIN1
   370: 0000C3   985D  cbi PORTD, RIN2
   371: 0000C4   9508  ret
   372: 
   373: ;--- GIRO DIREITA (no proprio eixo): roda E p/ frente, roda D p/ tras ---------
   374: ; resultado: carrinho gira no sentido horario (visto de cima) = vira p/ direita
   375: 
   376: TURN_RIGHT:
   377: 0000C5   9A5A  sbi PORTD, LIN1
   378: 0000C6   985B  cbi PORTD, LIN2
   379: 0000C7   985C  cbi PORTD, RIN1
   380: 0000C8   9A5D  sbi PORTD, RIN2
   381: 0000C9   9508  ret
   382: 
   383: 
   384: ;--- GIRO ESQUERDA (no proprio eixo): roda E p/ tras, roda D p/ frente --------
   385: 
   386: TURN_LEFT:
   387: 0000CA   985A  cbi PORTD, LIN1
   388: 0000CB   9A5B  sbi PORTD, LIN2
   389: 0000CC   9A5C  sbi PORTD, RIN1
   390: 0000CD   985D  cbi PORTD, RIN2
   391: 0000CE   9508  ret
   392: 
   393: ;--- DELAY ROTAÇÃO: espera um tempo com o motor rotacionando
   394: 
   395: WAIT_ROTATION:
   396: 0000CF   E005  ldi r16, (1<<CS12)|(1<<CS10)
   397: 0000D0   9300  sts TCCR1B,r16			;Configura PS 1024, iniciando contagem de 300ms (interrupção no match do comparador A do timer 1)
        0000D1   0081
   398: 
   399: wait_interrupt:
   400: 0000D2   110C  cpse r16, r12   ;Verifica se a interrupção foi ativada
   401: 0000D3   CFFE  rjmp wait_interrupt
   402: 
   403: ;Após ser ativada, encerra a SR de espera, desativando o timer
   404: 0000D4   2700  clr r16
   405: 0000D5   9300  sts TCCR1B,r16
        0000D6   0081
   406: 0000D7   9508  ret
   407: 
   408: 
   409: ;////////////////////////// SUB-ROTINAS DE INTERRUPÇÃO /////////////////////////////////
   410: 
   411: ;Compare match do Timer 1 -> Delay de rotação dos motores
   412: 
   413: INT_TIMER1_COMPA:
   414: 0000D8   E001  ldi r16, 0x01  ;Sinalizador de que a interrupção foi ativada
   415: 0000D9   9518  reti
   416: 
   417: 
   418: INT_RX_USART:
   419: ;Obs.: Preencher depois
   420: 0000DA   0000  nop
   421: 0000DB   9518  reti
   422: 
