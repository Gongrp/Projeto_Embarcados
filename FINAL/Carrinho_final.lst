   167: ;////////////////// CÓDIGO PRINCIPAL ///////////////////////////////
   168: 
   169: ;loop principal -> Realiza o processo de medição com o sensor ultrassônico e determina se o carrinho deve mudar de direção
   170: 
   171: main:
   172: 
   173: ;OBS.: INCORPORAR DEPOIS FILTRO MÉDIA MÓVEL PARA AS MEDIDAS DO ULTRASSONICO
   174: 00005F   D00A  rcall   DISPARA_TRIGGER
   175: 000060   D011  rcall   ESPERA_ECHO_SUBIR
   176: 000061   F018  brcs    SEM_ECO              ; carry=1 -> sensor não respondeu
   177: 
   178: 000062   D018  rcall   CRONOMETRA_ECHO
   179: ;rcall   CONVERTE_PARA_CM   ;Com PS 1024, valor do delay do echo é ~ distância em cm
   180: 000063   D02E  rcall   AVALIA_DISTANCIA
   181: 000064   C002  rjmp 	COOLDOWN
   182: 
   183: SEM_ECO:
   184: 000065   EF4F  ldi     r20, 0xFF        ; valor alto = "livre"
   185: 000066   D02B  rcall AVALIA_DISTANCIA
   186: 
   187: COOLDOWN:
   188: ; pausa entre medições (~80ms, recomendado pelo datasheet)
   189: 000067   E500  ldi     r16, 80
   190: 000068   D046  rcall   ESPERA_MS
   191: 
   192: 000069   CFF5  rjmp   main; Reinicia loop principal
   193: 
   194: 
   195: 
   196: ;////////////////////// SUB-ROTINAS //////////////////////////////////
   197: 
   198: DISPARA_TRIGGER:
   199: 00006A   9A2C  sbi     PORTB, TRIG
   200: ;10us a 16MHz = 160 ciclos de clock
   201: 00006B   E312  ldi     r17, 50
   202: 
   203: PULSO_TRIG: ;Aguarda 10 microsseg com TRIG em HIGH (implementado com decremento)
   204: 00006C   0000  nop
   205: 00006D   0000  nop
   206: 00006E   951A  dec     r17
   207: 00006F   F7E1  brne    PULSO_TRIG
   208: 000070   982C  cbi     PORTB, TRIG
   209: 000071   9508  ret
   210: 
   211: 
   212: ; Aguarda o pino ECHO ir para nível alto.
   213: ; Retorna: Carry = 1 se houve timeout (sem resposta do sensor)
   214: ;          Carry = 0 se ECHO subiu normalmente
   215: 
   216: ESPERA_ECHO_SUBIR:
   217: 000072   2722  clr r18           ; contador de timeout (256 voltas)
   218: 
   219: LACO_ESPERA_SUBIDA:
   220: 000073   991B  sbic    PINB, ECHO    ; se ECHO=0, pula a próxima linha
   221: 000074   C004  rjmp    ECHO_OK_SUBIU
   222: 000075   952A  dec     r18
   223: 000076   F7E1  brne    LACO_ESPERA_SUBIDA
   224: ; esgotou o tempo
   225: 000077   9408  sec                         ; seta carry = timeout
   226: 000078   9508  ret
   227: 
   228: ECHO_OK_SUBIU:
   229: 000079   9488  clc                         ; limpa carry = sucesso
   230: 00007A   9508  ret
   231: 
   232: ; Usa Timer2 com PS de 1024 para contar quanto tempo o pino ECHO permanece em nível alto.
   233: 
   234: ;/////// CRONOMETRA_ECHO /////////////////////
   235: 
   236: CRONOMETRA_ECHO:
   237: 00007B   2700  clr     r16
   238: 00007C   9300  sts     TCNT2, r16
        00007D   00B2
   239: 
   240: ; Liga Timer2 com prescaler 1024 (CS22=1, CS21=1, CS20=1)
   241: 00007E   E007  ldi     r16, (1<<CS22) | (1<<CS21) | (1<<CS20)
   242: 00007F   9300  sts     TCCR2B, r16
        000080   00B1
   243: 
   244: 
   245: ESPERA_ECHO_DESCER:
   246: 000081   9B1B  sbis    PINB, ECHO
   247: 000082   C009  rjmp    ECHO_DESCEU_OK
   248: 
   249: ;Controle de TIMEOUT: Verifica se o tempo estourou o limite
   250: 000083   9100  lds     r16,TCNT2
        000084   00B2
   251: 000085   3F0A  cpi     r16,250  ;Compara o valor do timer2 com o limite de timeout
   252: 000086   F3D0  brlo    ESPERA_ECHO_DESCER
   253: 
   254: ; TIMEOUT (executa esse bloco caso o timer chegue em 250 -> limite)
   255: 000087   2700  clr     r16
   256: 000088   9300  sts     TCCR2B, r16 ;Para o timer2
        000089   00B1
   257: 00008A   EF4F  ldi 	  r20,0xFF 		;Armazena o valor medido de distância em r20 (0xFF -> Valor de erro de timeout)
   258: 00008B   9508  ret
   259: 
   260: ECHO_DESCEU_OK:
   261: 00008C   2700  clr     r16
   262: 00008D   9300  sts     TCCR2B, r16 ;Para o timer2
        00008E   00B1
   263: 00008F   9140  lds     r20, TCNT2    ;Valor de tempo de demora da detecção será depois convertido em cm
        000090   00B2
   264: 000091   9508  ret
   265: 
   266: 
   267: ;/////////////////// TESTE DE DISTÂNCIA /////////////////////////////
   268: 
   269: ;Compara distância em cm medida com o limiar definido para determinar se o carrinho deve rotacionar, e em qual sentido (dependendo das rotações anteriores)
   270: ;Se estiver no meio de um processo de mudança de direção e não for detectado obstáculo, reinicia o movimento para frente
   271: 
   272: AVALIA_DISTANCIA:
   273: 000092   304A  cpi     r20, LIMIAR_CM
   274: 
   275: ;Se o valor em r20 for MENOR que o limiar -> obstáculo detectado
   276: 000093   F018  brlo    CHANGE_DIRECTION
   277: 
   278: ;Se não, limpa o registrador de rotações, reativa motores e volta ao loop principal
   279: 000094   2766  clr ROT_COUNT
   280: 000095   D028  rcall RUN_MOTORS
   281: 000096   9508  ret
   282: 
   283: CHANGE_DIRECTION:
   284: 000097   D02B  rcall STOP_MOTORS  ;OBS.: AVALIAR SE É NECESSÁRIO INSERIR DELAY PARA PARAR TOTALMENTE
   285: 000098   3060  cpi ROT_COUNT, 0x00
   286: 000099   F029  breq ROTATION_1
   287: 00009A   3061  cpi ROT_COUNT, 0x01
   288: 00009B   F039  breq ROTATION_2
   289: 00009C   3062  cpi ROT_COUNT, 0x02
   290: 00009D   F059  breq ROTATION_3
   291: 
   292: ;Se já estiver com o ROT_COUNT em 0x03 (encontrou obstáculo voltando a de onde veio, fica parado até detectar uma abertura)
   293: 00009E   9508  ret	;Sem incrementar o contador de rotações
   294: 
   295: 
   296: ;Se ROT_COUNT for 0x00, segue no normal (ROTATION_1)
   297: ROTATION_1:
   298: ;Gira uma vez para a esquerda
   299: 00009F   D02D  rcall TURN_LEFT
   300: 0000A0   D031  rcall WAIT_ROTATION
   301: 0000A1   D021  rcall STOP_MOTORS
   302: 0000A2   C00A  rjmp END_ROT
   303: 
   304: ROTATION_2:
   305: ;Gira duas vezes para a direita (sentido oposto da primeira rotação)
   306: 0000A3   D024  rcall TURN_RIGHT
   307: 0000A4   D02D  rcall WAIT_ROTATION
   308: 0000A5   D022  rcall TURN_RIGHT
   309: 0000A6   D02B  rcall WAIT_ROTATION
   310: 0000A7   D01B  rcall STOP_MOTORS
   311: 0000A8   C004  rjmp END_ROT
   312: 
   313: ROTATION_3:
   314: ;Gira mais uma vez para a direita, se direcionando no sentido oposto do qual veio antes da primeira detecção de obstáculo
   315: 0000A9   D01E  rcall TURN_RIGHT
   316: 0000AA   D027  rcall WAIT_ROTATION
   317: 0000AB   D017  rcall STOP_MOTORS
   318: 0000AC   C000  rjmp END_ROT
   319: 
   320: 
   321: END_ROT:
   322: 0000AD   9563  inc ROT_COUNT		;Aumenta o número de rotações realizadas
   323: 0000AE   9508  ret
   324: 
   325: 
   326: ;//////////// LOOP DE DELAY ENTRE MEDIÇÕES ////////////////////
   327: 
   328: ;Implementação de delay de cooldown do sensor ultrassônico por decremento
   329: 
   330: ;OBS.: COGITAR ALTERAR PARA TIMER
   331: 
   332: ESPERA_MS:
   333: 0000AF   930F  push    r16
   334: 0000B0   931F  push    r17
   335: 0000B1   932F  push    r18
   336: LOOP_MS:
   337: 0000B2   E118  ldi     r17, 24
   338: LOOP_4:
   339: 0000B3   EF2A  ldi     r18, 250
   340: LOOP_250:
   341: 0000B4   952A  dec     r18
   342: 0000B5   F7F1  brne    LOOP_250
   343: 0000B6   951A  dec     r17
   344: 0000B7   F7D9  brne    LOOP_4
   345: 0000B8   950A  dec     r16
   346: 0000B9   F7C1  brne    LOOP_MS
   347: 0000BA   912F  pop     r18
   348: 0000BB   911F  pop     r17
   349: 0000BC   910F  pop     r16
   350: 0000BD   9508  ret
   351: 
