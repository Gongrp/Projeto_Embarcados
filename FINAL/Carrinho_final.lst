    76: ;////////////// CONFIGURAÇÕES INICIAIS //////////////////////////
    77: 
    78: config:
    79: 
    80: ;Inicializando SP
    81: 000034   EF0F  ldi     R16,LOW(RAMEND)
    82: 000035   BF0D  out     SPL,R16
    83: 000036   E008  ldi     R16,HIGH(RAMEND)
    84: 000037   BF0E  out     SPH,R16
    85: 
    86: ;Configurações iniciais de registradores
    87: 
    88: ;Constante de comparação para sinalizar ativação de interrupts
    89: 000038   E001  ldi r16, 0x01
    90: 000039   2EC0  mov r12, r16
    91: 
    92: 00003A   2766  clr ROT_COUNT ;Inicia a contagem de rotações em zero
    93: 
    94: 
    95: ;Configuração das portas
    96: 
    97: ;PORTD:
    98: 00003B   E70C  ldi r16, (1<<LIN1)|(1<<LIN2)|(1<<RIN1)|(1<<RIN2)|(1<<PWM_PIN)
    99: 00003C   B90A  out DDRD, r16
   100: 00003D   2700  clr r16
   101: 00003E   B90B  out PORTD, r16
   102: ;Define todos os pinos dos motores como saída, zera os valores nas portas
   103: 
   104: ;PORTB:
   105: 00003F   E100  ldi r16, (1<<TRIG)
   106: 000040   B904  out DDRB,r16
   107: 000041   2700  clr r16
   108: 000042   B90B  out PORTD,r16
   109: ;Define o pino do TRIG como saída e o do ECHO como entrada, zera os valores nas portas
   110: 
   111: ;Configuração dos timers
   112: 
   113: ;TIMER0 -> PWM velocidade dos motores
   114: 
   115: 000043   E803  ldi r16, (1<<COM0A1)|(1<<WGM01)|(1<<WGM00)
   116: 000044   BD04  out TCCR0A,r16                              ;Configura timer0 no modo fast pwm, conecta comparador A no modo não inversor
   117: 000045   E003  ldi r16, (1<<CS01)|(1<<CS00)
   118: 000046   BD05  out TCCR0B,r16				    ;Configura PS 64
   119: ;Velocidade inicial??
   120: 
