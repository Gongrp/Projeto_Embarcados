   122: ;TIMER1 -> Delay de rotação do motor
   123: 
   124: 000047   E802  ldi r16, (1<<COM0A1)|(1<<WGM11)
   125: 000048   9300  sts TCCR1A,r16                  ;Configura timer 1 no modo CTC conectando comparador A no modo não inversor
        000049   0080
   126: 00004A   2700  clr r16
   127: 00004B   9300  sts TCCR1B,r16			;Timer inicia desativado
        00004C   0081
   128: 00004D   E60A  ldi r16, low(ROT_DELAY)
   129: 00004E   9300  sts OCR1AL,r16
        00004F   0088
   130: 000050   E108  ldi r16, high(ROT_DELAY)
   131: 000051   9300  sts OCR1AH,r16			;Salva no comparador o número de contagens definido pelo delay desejado -> Determina ângulo de rotação
        000052   0089
   132: 
   133: 
   134: ;TIMER2 -> Detecção do sensor ultrassônico (tempo entre emissão no TRIG e recepção no ECHO)
   135: 
   136: 000053   E000  ldi r16,0x00
   137: 000054   9300  sts TCCR2A,r16 	   ;Configura timer 2 no modo normal (delay)
        000055   00B0
   138: 000056   9300  sts TCCR2B,r16     ;Timer2 inicia desativado
        000057   00B1
   139: 
   140: ;Configuração das interrupções:
   141: 
   142: ;Interrupt do timer 1
   143: 000058   E002  ldi r16, (1<<OCIE1A)
   144: 000059   9300  sts TIMSK1,r16
        00005A   006F
   145: 
   146: ;OBS. configurar demais interrupções
   147: 
   148: 00005B   9478  sei
   149: ;
   150: 
   151: ;Configuração da comunicação USART
   152: 
   153: 
   154: ;OBS. preencher depois
   155: 
   156: ;Inicialização dos motores em velocidade padrão
   157: 
   158: 00005C   EA00  ldi r16, DUTY_STD
   159: 00005D   BD07  out OCR0A,r16		;Define duty cycle inicial dos motores
   160: 
