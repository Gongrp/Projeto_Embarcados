     8: ;///////////////// CONSTANTES E PINAGEM ///////////////////////
     9: 
    10: ;PODEMOS REDEFINIR OS PARÂMETROS AQUI FACILMENTE, SEM MEXER NO CORPO DO CÓDIGO (DE OLHO EM VCS FIR E MESTRE)
    11: 
    12: 
    13: ;PINOS
    14: 
    15: ; Ponte-H ESQUERDA (Motor E)         Ponte-H DIREITA (Motor D)
    16: ;   PD2 = IN1 (E)                      PD4 = IN1 (D)
    17: ;   PD3 = IN2 (E)                      PD5 = IN2 (D)
    18: 
    19: ; Convencao por roda: IN1=1,IN2=0 -> "frente"  |  IN1=0,IN2=1 -> "tras"
    20: 
    21: .equ LIN1 = PD2
    22: .equ LIN2 = PD3
    23: .equ RIN1 = PD4
    24: .equ RIN2 = PD5
    25: .equ PWM_PIN = PD6 ; PWM VELOCIDADE (saida OC0A do Timer0) -> ligar FISICAMENTE em ENA E ENB
    26: 
    27: ; SENSOR ULTRASSÔNICO
    28: 
    29: .equ TRIG = PB4
    30: .equ ECHO = PB3
    31: 
    32: ;COMUNICAÇÃO USART MÓDULO BLUETOOTH
    33: 
    34: .equ RX = PD0
    35: .equ TX = PD1
    36: 
    37: 
    38: ; CONSTANTES
    39: 
    40: ;MODOS DE VELOCIDADE DO MOTOR
    41: 
    42: .equ DUTY_SLOW = 90       ; ~35%
    43: .equ DUTY_STD  = 160      ; ~63%
    44: .equ DUTY_FAST = 255      ; 100%
    45: 
    46: ;Delay de rotação dos motores  (400ms)
    47: .equ ROT_DELAY = 6250 		;Número de contagens com PS de 1024 -> N = T_DELAY(s) * (16M/PS)
    48: 
    49: 
    50: ;Baud rate comunicação USART:
    51: 
    52: ;Distância de alcance sensor
    53: .equ    LIMIAR_CM = 10
    54: 
    55: ;Variável de controle de mudanças de direção realizadas (incrementada a cada rotação sucessiva e é zerado quando o carro pode seguir em frente)
    56: .def ROT_COUNT = r22
    57: 
    58: ;Variável de registro de ocorrência de interrupção do comparadorA
    59: .def TIMER1_FLAG = r21
    60: 
    61: 
    62: ;////////////// VETORES DE INTERRUPÇÃO ///////////////////////////////
    63: 
    64: .cseg
    65: .org 0x0000
    66: 000000   C033  rjmp config ;Pula para a SR de configuração
    67: 
    68: ;Incluir interrupções para os timers 0 e 2?
    69: 
    70: .org 0x0016
    71: 000016   C0CA  rjmp INT_TIMER1_COMPA
    72: 
    73: .org 0x0024
    74: 000024   C0BE  rjmp INT_RX_USART
    75: 
    76: 
    77: ;////////////// CONFIGURAÇÕES INICIAIS //////////////////////////
    78: 
    79: .org 0x0034
    80: config:
    81: 
    82: ;Inicializando SP
    83: 000034   EF0F  ldi     R16,LOW(RAMEND)
    84: 000035   BF0D  out     SPL,R16
    85: 000036   E008  ldi     R16,HIGH(RAMEND)
    86: 000037   BF0E  out     SPH,R16
    87: 
    88: ;Configurações iniciais de registradores
    89: 
    90: ;Constante de comparação para sinalizar ativação de interrupts
    91: 000038   E001  ldi r16, 0x01
    92: 000039   2EC0  mov r12, r16
    93: 
    94: 00003A   2766  clr ROT_COUNT ;Inicia a contagem de rotações em zero
    95: 
    96: 
    97: ;Configuração das portas
    98: 
    99: ;PORTD:
   100: 00003B   E70C  ldi r16, (1<<LIN1)|(1<<LIN2)|(1<<RIN1)|(1<<RIN2)|(1<<PWM_PIN)
   101: 00003C   B90A  out DDRD, r16
   102: 00003D   2700  clr r16
   103: 00003E   B90B  out PORTD, r16
   104: ;Define todos os pinos dos motores como saída, zera os valores nas portas
   105: 
   106: ;PORTB:
   107: 00003F   E100  ldi r16, (1<<TRIG)
   108: 000040   B904  out DDRB,r16
   109: 000041   2700  clr r16
   110: 000042   B905  out PORTB,r16
   111: ;Define o pino do TRIG como saída e o do ECHO como entrada, zera os valores nas portas
   112: 
   113: ;Configuração dos timers
   114: 
   115: ;TIMER0 -> PWM velocidade dos motores
   116: 
   117: 000043   E803  ldi r16, (1<<COM0A1)|(1<<WGM01)|(1<<WGM00)
   118: 000044   BD04  out TCCR0A,r16                              ;Configura timer0 no modo fast pwm, conecta comparador A no modo não inversor
   119: 000045   E003  ldi r16, (1<<CS01)|(1<<CS00)
   120: 000046   BD05  out TCCR0B,r16				    ;Configura PS 64
   121: ;Velocidade inicial??
   122: 
   123: 
   124: ;TIMER1 -> Delay de rotação do motor
   125: 
   126: ;ldi r16, (1<<COM1A1)|(1<<WGM11)
   127: 000047   2700  clr r16
   128: 000048   9300  sts TCCR1A,r16                  ;Configura timer 1 no modo CTC conectando comparador A no modo não inversor
        000049   0080
   129: 00004A   E008  ldi r16, (1<<WGM12)
   130: 00004B   9300  sts TCCR1B,r16			            ;Timer inicia desativado
        00004C   0081
   131: 00004D   E60A  ldi r16, low(ROT_DELAY)
   132: 00004E   9300  sts OCR1AL,r16
        00004F   0088
   133: 000050   E108  ldi r16, high(ROT_DELAY)
   134: 000051   9300  sts OCR1AH,r16			;Salva no comparador o número de contagens definido pelo delay desejado -> Determina ângulo de rotação
        000052   0089
   135: 
   136: 
   137: ;TIMER2 -> Detecção do sensor ultrassônico (tempo entre emissão no TRIG e recepção no ECHO)
   138: 
   139: 000053   E000  ldi r16,0x00
   140: 000054   9300  sts TCCR2A,r16 	   ;Configura timer 2 no modo normal (delay)
        000055   00B0
   141: 000056   9300  sts TCCR2B,r16     ;Timer2 inicia desativado
        000057   00B1
   142: 
   143: ;Configuração das interrupções:
   144: 
   145: ;Interrupt do timer 1
   146: 000058   E002  ldi r16, (1<<OCIE1A)
   147: 000059   9300  sts TIMSK1,r16
        00005A   006F
   148: 
   149: ;OBS. configurar demais interrupções
   150: 
   151: 00005B   9478  sei
   152: ;
   153: 
   154: ;Configuração da comunicação USART
   155: 
   156: 
   157: ;OBS. preencher depois
   158: 
   159: ;Inicialização dos motores em velocidade padrão
   160: 
   161: 00005C   EA00  ldi r16, DUTY_STD
   162: 00005D   BD07  out OCR0A,r16		;Define duty cycle inicial dos motores
   163: 
   164: 00005E   D05F  rcall RUN_MOTORS	;Inicia movimento para frente
