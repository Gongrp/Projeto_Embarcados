   164: ;////////////////// CÓDIGO PRINCIPAL ///////////////////////////////
   165: 
   166: ;loop principal -> Realiza o processo de medição com o sensor ultrassônico e determina se o carrinho deve mudar de direção
   167: 
   168: main:
   169: 
   170: ;OBS.: INCORPORAR DEPOIS FILTRO MÉDIA MÓVEL PARA AS MEDIDAS DO ULTRASSONICO
   171: 00005F   D00A  rcall   DISPARA_TRIGGER
   172: 000060   D011  rcall   ESPERA_ECHO_SUBIR
   173: 000061   F018  brcs    SEM_ECO              ; carry=1 -> sensor não respondeu
   174: 
   175: 000062   D018  rcall   CRONOMETRA_ECHO
   176: ;rcall   CONVERTE_PARA_CM   ;Com PS 1024, valor do delay do echo é ~ distância em cm
   177: 000063   D02D  rcall   AVALIA_DISTANCIA
   178: 000064   C002  rjmp 	COOLDOWN
   179: 
   180: SEM_ECO:
   181: 000065   EF4F  ldi     r20, 0xFF        ; valor alto = "livre"
   182: 000066   D02A  rcall AVALIA_DISTANCIA
   183: 
   184: COOLDOWN:
   185: ; pausa entre medições (~80ms, recomendado pelo datasheet)
   186: 000067   E500  ldi     r16, 80
   187: 000068   D043  rcall   ESPERA_MS
   188: 
   189: 000069   CFF5  rjmp   main; Reinicia loop principal
   190: 
   191: 
   192: 
   193: ;////////////////////// SUB-ROTINAS //////////////////////////////////
   194: 
   195: DISPARA_TRIGGER:
   196: 00006A   9A2C  sbi     PORTB, TRIG
   197: ;10us a 16MHz = 160 ciclos de clock
   198: 00006B   E312  ldi     r17, 50
   199: 
   200: PULSO_TRIG: ;Aguarda 10 microsseg com TRIG em HIGH (implementado com decremento)
   201: 00006C   0000  nop
   202: 00006D   0000  nop
   203: 00006E   951A  dec     r17
   204: 00006F   F7E1  brne    PULSO_TRIG
   205: 000070   982C  cbi     PORTB, TRIG
   206: 000071   9508  ret
   207: 
   208: 
   209: ; Aguarda o pino ECHO ir para nível alto.
   210: ; Retorna: Carry = 1 se houve timeout (sem resposta do sensor)
   211: ;          Carry = 0 se ECHO subiu normalmente
   212: 
   213: ESPERA_ECHO_SUBIR:
   214: 000072   2722  clr r18           ; contador de timeout (256 voltas)
   215: 
   216: LACO_ESPERA_SUBIDA:
   217: 000073   991B  sbic    PINB, ECHO    ; se ECHO=0, pula a próxima linha
   218: 000074   C004  rjmp    ECHO_OK_SUBIU
   219: 000075   952A  dec     r18
   220: 000076   F7E1  brne    LACO_ESPERA_SUBIDA
   221: ; esgotou o tempo
   222: 000077   9408  sec                         ; seta carry = timeout
   223: 000078   9508  ret
   224: 
   225: ECHO_OK_SUBIU:
   226: 000079   9488  clc                         ; limpa carry = sucesso
   227: 00007A   9508  ret
   228: 
   229: ; Usa Timer2 com PS de 1024 para contar quanto tempo o pino ECHO permanece em nível alto.
   230: 
   231: ;/////// CRONOMETRA_ECHO /////////////////////
   232: 
   233: CRONOMETRA_ECHO:
   234: 00007B   2700  clr     r16
   235: 00007C   9300  sts     TCNT2, r16
        00007D   00B2
   236: 
   237: ; Liga Timer2 com prescaler 1024 (CS22=1, CS21=1, CS20=1)
   238: 00007E   E007  ldi     r16, (1<<CS22) | (1<<CS21) | (1<<CS20)
   239: 00007F   9300  sts     TCCR2B, r16
        000080   00B1
   240: 
   241: ; Timeout para não travar
   242: 000081   EF1F  ldi     r17, 0xFF
   243: 
   244: ESPERA_ECHO_DESCER:
   245: 000082   9B1B  sbis    PINB, ECHO
   246: 000083   C007  rjmp    ECHO_DESCEU_OK
   247: 
   248: 000084   951A  dec     r17
   249: 000085   F7E1  brne    ESPERA_ECHO_DESCER
   250: 
   251: ; TIMEOUT (executa esse bloco caso r17 chegue a zero)
   252: 000086   2700  clr     r16
   253: 000087   9300  sts     TCCR2B, r16 ;Para o timer2
        000088   00B1
   254: 000089   EF4F  ldi 	r20,0xFF 		;Armazena o valor medido de distância em r20 (0xFF -> Valor de erro de timeout)
   255: 00008A   9508  ret
   256: 
   257: ECHO_DESCEU_OK:
   258: 00008B   2700  clr     r16
   259: 00008C   9300  sts     TCCR2B, r16 ;Para o timer2
        00008D   00B1
   260: 00008E   9140  lds     r20, TCNT2    ;Valor de tempo de demora da detecção será depois convertido em cm
        00008F   00B2
   261: 000090   9508  ret
   262: 
   263: 
   264: ;/////////////////// TESTE DE DISTÂNCIA /////////////////////////////
   265: 
   266: ;Compara distância em cm medida com o limiar definido para determinar se o carrinho deve rotacionar, e em qual sentido (dependendo das rotações anteriores)
   267: ;Se estiver no meio de um processo de mudança de direção e não for detectado obstáculo, reinicia o movimento para frente
   268: 
   269: AVALIA_DISTANCIA:
   270: 000091   304A  cpi     r20, LIMIAR_CM
   271: 
   272: ;Se o valor em r20 for MENOR que o limiar -> obstáculo detectado
   273: 000092   F018  brlo    CHANGE_DIRECTION
   274: 
   275: ;Se não, limpa o registrador de rotações, reativa motores e volta ao loop principal
   276: 000093   2766  clr ROT_COUNT
   277: 000094   D026  rcall RUN_MOTORS
   278: 000095   9508  ret
   279: 
   280: CHANGE_DIRECTION:
   281: 000096   D029  rcall STOP_MOTORS
   282: 000097   3060  cpi ROT_COUNT, 0x00
   283: 000098   F031  breq ROTATION_1
   284: 000099   3061  cpi ROT_COUNT, 0x01
   285: 00009A   F039  breq ROTATION_2
   286: 00009B   3062  cpi ROT_COUNT, 0x02
   287: 00009C   F051  breq ROTATION_3
   288: 00009D   C00C  rjmp END_ROT
   289: 
   290: ;Se já estiver com o ROT_COUNT em 0x03 (encontrou obstáculo voltando a de onde veio, fica parado até detectar uma abertura)
   291: 00009E   9508  ret	;Sem incrementar o contador de rotações
   292: 
   293: 
   294: ;Se ROT_COUNT for 0x00, segue no normal (ROTATION_1)
   295: ROTATION_1:
   296: ;Gira uma vez para a esquerda
   297: 00009F   D02A  rcall TURN_LEFT
   298: 0000A0   D02E  rcall WAIT_ROTATION
   299: 0000A1   C008  rjmp END_ROT
   300: 
   301: ROTATION_2:
   302: ;Gira duas vezes para a direita (sentido oposto da primeira rotação)
   303: 0000A2   D022  rcall TURN_RIGHT
   304: 0000A3   D02B  rcall WAIT_ROTATION
   305: 0000A4   D020  rcall TURN_RIGHT
   306: 0000A5   D029  rcall WAIT_ROTATION
   307: 0000A6   C003  rjmp END_ROT
   308: 
   309: ROTATION_3:
   310: ;Gira mais uma vez para a direita, se direcionando no sentido oposto do qual veio antes da primeira detecção de obstáculo
   311: 0000A7   D01D  rcall TURN_RIGHT
   312: 0000A8   D026  rcall WAIT_ROTATION
   313: 0000A9   C000  rjmp END_ROT
   314: 
   315: 
   316: END_ROT:
   317: 0000AA   9563  inc ROT_COUNT		;Aumenta o número de rotações realizadas
   318: 0000AB   9508  ret
   319: 
   320: 
   321: ;//////////// LOOP DE DELAY ENTRE MEDIÇÕES ////////////////////
   322: 
   323: ;Implementação de delay de cooldown do sensor ultrassônico por decremento
   324: 
   325: ;OBS.: COGITAR ALTERAR PARA TIMER
   326: 
   327: ESPERA_MS:
   328: 0000AC   930F  push    r16
   329: 0000AD   931F  push    r17
   330: 0000AE   932F  push    r18
   331: LOOP_MS:
   332: 0000AF   E014  ldi     r17, 4
   333: LOOP_4:
   334: 0000B0   EF2A  ldi     r18, 250
   335: LOOP_250:
   336: 0000B1   952A  dec     r18
   337: 0000B2   F7F1  brne    LOOP_250
   338: 0000B3   951A  dec     r17
   339: 0000B4   F7D9  brne    LOOP_4
   340: 0000B5   950A  dec     r16
   341: 0000B6   F7C1  brne    LOOP_MS
   342: 0000B7   912F  pop     r18
   343: 0000B8   911F  pop     r17
   344: 0000B9   910F  pop     r16
   345: 0000BA   9508  ret
   346: 
   347: 
   348: 
