   355: ;//////////////////// AÇÕES DOS MOTORES /////////////////////////////
   356: 
   357: ;--- FRENTE: as duas rodas "para frente" (carrinho avança) --------------------
   358: ; Com motores espelhados, "ambas para frente" corresponde a rotacoes FISICAS
   359: ; opostas (uma roda horario, outra anti-horario) -> exatamente sua descricao.
   360: 
   361: RUN_MOTORS:
   362: 0000BE   9A5A  sbi PORTD, LIN1
   363: 0000BF   985B  cbi PORTD, LIN2
   364: 0000C0   9A5C  sbi PORTD, RIN1
   365: 0000C1   985D  cbi PORTD, RIN2
   366: 0000C2   9508  ret
   367: 
   368: 
   369: ;--- PARADO: desliga as 4 chaves (motores em roda-livre) ----------------------
   370: 
   371: STOP_MOTORS:
   372: 0000C3   985A  cbi PORTD, LIN1
   373: 0000C4   985B  cbi PORTD, LIN2
   374: 0000C5   985C  cbi PORTD, RIN1
   375: 0000C6   985D  cbi PORTD, RIN2
   376: 0000C7   9508  ret
   377: 
   378: ;--- GIRO DIREITA (no proprio eixo): roda E p/ frente, roda D p/ tras ---------
   379: ; resultado: carrinho gira no sentido horario (visto de cima) = vira p/ direita
   380: 
   381: TURN_RIGHT:
   382: 0000C8   9A5A  sbi PORTD, LIN1
   383: 0000C9   985B  cbi PORTD, LIN2
   384: 0000CA   985C  cbi PORTD, RIN1
   385: 0000CB   9A5D  sbi PORTD, RIN2
   386: 0000CC   9508  ret
   387: 
   388: 
   389: ;--- GIRO ESQUERDA (no proprio eixo): roda E p/ tras, roda D p/ frente --------
   390: 
   391: TURN_LEFT:
   392: 0000CD   985A  cbi PORTD, LIN1
   393: 0000CE   9A5B  sbi PORTD, LIN2
   394: 0000CF   9A5C  sbi PORTD, RIN1
   395: 0000D0   985D  cbi PORTD, RIN2
   396: 0000D1   9508  ret
   397: 
   398: ;--- DELAY ROTAÇÃO: espera um tempo com o motor rotacionando
   399: 
   400: WAIT_ROTATION:
   401: 
   402: 0000D2   2700  clr r16
   403: 0000D3   9300  sts TCNT1H, r16
        0000D4   0085
   404: 0000D5   9300  sts TCNT1L, r16     ;zera o timer 1
        0000D6   0084
   405: 
   406: ;ldi r16, (1<<CS12)|(1<<CS10)
   407: 0000D7   E00D  ldi r16, (1<<WGM12)|(1<<CS12)|(1<<CS10)
   408: 0000D8   9300  sts TCCR1B,r16			;Configura PS 1024, iniciando contagem (interrupção no match do comparador A do timer 1)
        0000D9   0081
   409: 
   410: wait_interrupt:
   411: 0000DA   115C  cpse TIMER1_FLAG, r12   ;Verifica se a interrupção foi ativada
   412: 0000DB   CFFE  rjmp wait_interrupt
   413: 
   414: ;Após ser ativada, encerra a SR de espera, desativando o timer
   415: 0000DC   2755  clr TIMER1_FLAG
   416: 0000DD   E008  ldi r16,(1<<WGM12)
   417: 0000DE   9300  sts TCCR1B,r16
        0000DF   0081
   418: 0000E0   9508  ret
   419: 
   420: 
   421: ;////////////////////////// SUB-ROTINAS DE INTERRUPÇÃO /////////////////////////////////
   422: 
   423: ;Compare match do Timer 1 -> Delay de rotação dos motores
   424: 
   425: INT_TIMER1_COMPA:
   426: 0000E1   E051  ldi TIMER1_FLAG, 0x01  ;Sinalizador de que a interrupção foi ativada
   427: 0000E2   9518  reti
   428: 
   429: 
   430: INT_RX_USART:
   431: ;Obs.: Preencher depois
   432: 0000E3   0000  nop
   433: 0000E4   9518  reti
